<!DOCTYPE html>
<html lang="th">
<head>
  <meta charset="UTF-8">
  <title>พรีวิวใบชั่งน้ำหนัก (ขนาด A4)</title>
  <style>
    /* =========================================
       1. โซนจำลองกระดาษ A4 (A4 Paper Simulator)
       ========================================= */
    body {
      background: #525659; /* สีหลังเทาๆ เหมือนโปรแกรมเปิด PDF */
      margin: 0;
      padding: 20px 0;
    }
    .a4-paper {
      background: white;
      width: 210mm;          /* ความกว้างสากลของ A4 */
      min-height: 297mm;     /* ความสูงสากลของ A4 */
      margin: 0 auto;        /* จัดให้อยู่กึ่งกลางจอ */
      padding: 10mm;         /* ขอบกระดาษขาวกันเครื่องปริ้นต์กินขอบ */
      box-shadow: 0 0 10px rgba(0,0,0,0.5); /* เงากระดาษ */
      box-sizing: border-box;
    }

    /* 🛡️ กฎเหล็กตอนกดสั่งปริ้นต์ (Ctrl+P) */
    @page {
      size: A4;
      margin: 0; /* ลบขอบกระดาษของเบราว์เซอร์ทิ้ง */
    }
    @media print {
      body { background: white; padding: 0; }
      .a4-paper { margin: 0; box-shadow: none; } /* เอาเงาออกตอนปริ้นต์จริง */
    }

    /* =========================================
       2. โซนสไตล์ใบ Label ของ Asia Kraft
       ========================================= */
    .label-box {
      width: 100%;
      border: 2px solid #000;
      font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
    }
    .header { text-align: center; border-bottom: 2px solid #000; padding: 10px; }
    .header h1 { font-family: 'Brush Script MT', cursive; font-size: 32px; margin: 0; }
    .header p { font-size: 12px; font-style: italic; margin: 5px 0 0 0; font-weight: bold; }
    
    table.data-table { width: 100%; border-collapse: collapse; text-transform: uppercase; }
    table.data-table td { border-bottom: 1px solid #000; padding: 8px; }
    .col-label { font-size: 22px; font-weight: bold; width: 30%; vertical-align: top;}
    .col-value { font-size: 55px; text-align: center; }
    .col-unit { font-size: 12px; text-align: right; vertical-align: bottom; }
    
    .barcode-section { border-bottom: 2px solid #000; padding: 10px; text-align: right; }
    .barcode-section h2 { font-size: 36px; margin: 0; letter-spacing: 2px; }
    .barcode-img-placeholder { 
      display: inline-block; width: 80%; height: 60px; 
      background: #ccc; text-align: center; line-height: 60px;
      font-size: 12px; margin-top: 5px;
    }

    .footer-section { display: flex; width: 100%; }
    .footer-left { width: 50%; border-right: 1px solid #000; }
    .footer-left td { border-bottom: 1px solid #000; padding: 4px; font-size: 12px; }
    .footer-right { width: 50%; text-align: center; padding: 10px; }
    .status-hold { font-size: 24px; font-weight: bold; margin-top: 5px; }
  </style>
</head>
<body>

  <div class="a4-paper">
    
    <div class="label-box">
      <div class="header">
        <h1>Asia Kraft</h1>
        <p>Customers First Quality Always</p>
      </div>

      <table class="data-table">
        <tr>
          <td class="col-label" >GRADE</td>
          <td class="col-value"><%= (grade) ? grade : '' %></td>
          <td class="col-unit">GSM.</td>
        </tr>
        <tr>
          <td class="col-label">SIZE</td>
          <td class="col-value"><%= (size) ? size : '' %></td>
          <td class="col-unit">IN.</td>
        </tr>
        <tr>
          <td class="col-label">WEIGHT</td>
          <td class="col-value"><%= (weight) ? weight : '' %></td>
          <td class="col-unit">KG.</td>
        </tr>
        <tr>
          <td colspan="3" style="padding: 0;">
            <table style="width: 100%; border-collapse: collapse; border: none;">
              <tr>
                <td class="col-label" style="border: none; border-right: 1px solid #000; width: 50%; padding: 8px;">
                  DIAMETER <span style="font-size: 28px; float: right;"><%= (diameter) ? diameter : '' %></span>
                </td>
                <td class="col-label" style="border: none; padding: 8px;">
                  DATE <span style="font-size: 24px; float: right;"><%= (date) ? date : '' %></span>
                </td>
              </tr>
            </table>
          </td>
        </tr>
      </table>

      <div class="barcode-section">
        <div style="float: left; font-weight: bold; font-size: 16px;">ROLL NO</div>
        <h2><%= rollNo %></h2>
        
        <img class="barcode-img" src="<%= barcodeImg %>" alt="Barcode Main" style="width: 80%; height: 70px;">
      </div>

      <div class="footer-section">
        <div class="footer-left">
          <table style="width: 100%; border-collapse: collapse;">
            <tr><td>GRADE</td><td style="text-align: right;">CF150F</td></tr>
            <tr><td>SIZE</td><td style="text-align: right;">84</td></tr>
            <tr><td>DIAMETER</td><td style="text-align: right;">48</td></tr>
            <tr><td>WEIGHT</td><td style="text-align: right;">1,768</td></tr>
            <tr><td style="border: none;">DATE</td><td style="border: none; text-align: right;">11/01/2026</td></tr>
          </table>
        </div>
        <div class="footer-right">
          <img src="<%= barcodeImg %>" alt="Barcode Mini" style="width: 90%; height: 40px; display: block; margin: 0 auto;">
          <div style="font-size: 14px; margin-top: 5px; font-weight: bold;"><%= rollNo %></div>
          <div class="status-hold" style="font-size: 24px; font-weight: bold; margin-top: 5px;">*HOLD*</div>
        </div>
      </div>
    </div>
    
    </div>

</body>
</html>
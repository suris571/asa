<!DOCTYPE html>
<html lang="th">
<head>
  <meta charset="UTF-8">
  <title>โครงสร้างหน้ากระดาษและตาราง (Skeleton Layout)</title>
  <style>
    /* 🎯 1. ตั้งค่ากระดาษ A4 และระยะขอบ */
    body {
      background: #525659;
      margin: 0;
      padding: 20px 0;
      display: flex;
      justify-content: center;
      font-family: 'Times New Roman', Times, serif; /* ใช้ฟอนต์แบบต้นฉบับ */
    }
    .a4-paper {
      background: white;
      width: 210mm;
      height: 297mm;
      padding: 25mm 10mm 15mm 2mm;
      box-shadow: 0 0 10px rgba(0,0,0,0.5);
      box-sizing: border-box;
    }

    @page { size: A4 portrait; margin: 0; }
    @media print {
      body { background: white; padding: 0; }
      .a4-paper { margin: 0; box-shadow: none; width: 210mm; height: 297mm; }
    }

    /* 🎯 2. โครงสร้างกล่องด้านบน */
    .top-box {
      border: 1px solid #000; /* เส้นขอบรอบกล่องบน */
      width: 100%;
    }

    /* โซนโลโก้ (Header) */
    .header-section {
      border-bottom: 1px solid #000;
      padding: 15px;
    }
    .logo-frame {
      display: flex;
      border: 1px solid #000; /* กรอบสี่เหลี่ยมรอบโลโก้ */
      width: 75%;
      margin: 0 auto;
      height: 70px;
    }
    .logo-left {
      width: 50%;
      border-right: 1px solid #000; /* เส้นกั้นกลางระหว่าง Asia กับ Kraft */
      display: flex; align-items: center; justify-content: center;
    }
    .logo-right {
      width: 50%;
      display: flex; align-items: center; justify-content: center;
    }
    .slogan {
      text-align: center;
      margin-top: 10px;
      font-size: 14px;
    }

    /* ตารางกล่องบน (GRADE, SIZE, WEIGHT, DIAMETER, DATE, ROLL NO) */
    .top-table {
      width: 100%;
      border-collapse: collapse;
    }
    .top-table td {
      border-bottom: 1px solid #000;
      padding: 10px 15px;
      height: 100px; /* ล็อกความสูงแต่ละบรรทัดให้โปร่งๆ */
      vertical-align: top;
    }
    .top-table tr:last-child td {
      border-bottom: none; /* บรรทัดล่างสุดใช้ขอบของ top-box แทน */
      height: 110px; /* พื้นที่สำหรับ ROLL NO และบาร์โค้ด */
    }

    /* สัดส่วนคอลัมน์ในกล่องบน */
    .lbl { font-size: 35px; width: 120px; }
    .unit { text-align: right; vertical-align: bottom !important; width: 50px; font-size: 22px; }

    /* โซนแบ่งครึ่ง DIAMETER / DATE */
    .split-row td {
      padding: 0;
      height: 65px;
    }
    .split-container {
      display: flex;
      width: 100%;
      height: 100%;
    }
    .split-left {
      width: 45%; /* สัดส่วนฝั่ง DIAMETER */
      border-right: 1px solid #000; /* เส้นกั้นกลาง */
      padding: 10px 15px;
      position: relative;
    }
    .split-right {
      width: 55%; /* สัดส่วนฝั่ง DATE */
      padding: 10px 15px;
    }
    .unit-bottom {
      position: absolute;
      bottom: 10px;
      right: 15px;
      font-size: 14px;
    }

    /* 🎯 3. โครงสร้างกล่องด้านล่าง (แยกอิสระ) */
    .bottom-box {
      border: 1px solid #000;
      width: 100%;
      margin-top: 7mm; /* ระยะห่างระหว่างกล่องบนและล่าง */
      display: flex; /* แบ่งซ้ายขวา */
      height: 150px;
    }

    .bottom-left {
      width: 45%;
      border-right: 1px solid #000; /* เส้นกั้นกลางของกล่องล่าง */
    }
    .bottom-right {
      width: 55%;
      padding: 10px;
    }

    /* ตารางภายในกล่องล่างฝั่งซ้าย */
    .bottom-table {
      width: 100%;
      border-collapse: collapse;
      height: 100%;
    }
    .bottom-table td {
      border-bottom: 1px solid #000;
      padding: 5px 10px;
      font-size: 14px;
    }
    .bottom-table tr:last-child td {
      border-bottom: none; /* บรรทัดสุดท้ายไม่มีเส้นใต้ */
    }
    .value_top {
      font-size: 90px;
      font-weight: 600;
      text-align: center;
      display: flex;
      align-content: center;
      justify-content: center;
      align-items: center;
      font-weight: normal !important;
    }
        .header { text-align: center; border-bottom: 2px solid #000; padding: 30px; }
    .header h1 { font-family: 'Brush Script MT', cursive;  margin: 0; }
    .as { font-size: 30px; font-family: 'Brush Script MT', 'Brush Script Std', cursive;
font-style: italic;
font-weight: 400;letter-spacing: 1.5px; }


/* =========================================
   กล่องล่าง (Bottom Box Section)
   ========================================= */
.bottom-box {
  display: flex;
  width: 100%;
  border: 1px solid #000;
  box-sizing: border-box;
  margin-top: 15px;
  font-family: 'Times New Roman', Times, serif;
  background: #ffffff;
}

/* ฝั่งซ้าย: ตาราง */
.bottom-left {
  width: 45%;
  border-right: 1px solid #000;
  box-sizing: border-box;
}

.bottom-table {
  width: 100%;
  border-collapse: collapse;
  table-layout: fixed;
}

.bottom-table tr.border-b {
  border-bottom: 1px solid #000;
}

.bottom-table td {
  padding: 5px 4px;
  font-size: 20px;
  text-align: center;
}

.bottom-table .b-label {
  padding: 5px 8px;
  font-size: 18px;
  font-weight: normal;
  text-align: left;
  width: 38%;
}

.bottom-table .b-unit {
  padding: 5px 4px 2px 0;
  font-size: 11px;
  text-align: right;
  vertical-align: bottom;
  width: 35px;
}

/* ฝั่งขวา: บาร์โค้ด + HOLD */
.bottom-right {
  width: 55%;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  padding: 12px;
  box-sizing: border-box;
}

.mini-barcode {
  width: 230px;
  height: 38px;
  object-fit: fill;
}

.mini-rollno {
  font-size: 13px;
  margin-top: 4px;
}

.mini-status {
  font-size: 42px;
  font-weight: normal;
  margin-top: 6px;
  letter-spacing: 1px;
}
.left_a{
  font-size: 25px!important;
}
.center_a{
  font-size: 25px!important;
  text-align: right!important;
  padding-right: 25px !important;
}
  </style>
</head>
<body>

  <div class="a4-paper">
    
    <!-- ==================== กล่องบน ==================== -->
    <div class="top-box">
      <!-- โซน Header -->
      <!-- <div class="header-section">
        <div class="logo-frame header">
          <div class="logo-left" style="font-size: 65px;"><h1>Asia</h1></div>
          <div class="logo-right" style="font-size: 65px;"><h1>Kraft</h1></div>
        </div>
        <div class="slogan as">Customers First Zuality Always</div>
      </div>
    <div class="top-box"> -->
      <!-- โซน Header -->
      <div class="header-section">
        <img src="data:image/jpeg;base64," alt="Logo" style="width: 100%; height: 100%; display: block; margin: 0 auto;">
      </div>

      <!-- โซนตารางหลัก -->
      <table class="top-table">
        <tr>
          <td class="lbl">GRADE</td>
          <td class="value_top" style="padding-right: 138px;"><%= (grade) ? grade : '' %></td>
          <td class="unit">GSM.</td>
        </tr>
        <tr>
          <td class="lbl">SIZE</td>
          <td class="value_top" style="padding-right: 138px;"><%= (size) ? size : '' %></td>
          <td class="unit">IN.</td>
        </tr>
        <tr>
          <td class="lbl" style="height: 42px;">WEIGHT</td>
          <td class="value_top" style="height: 42px;font-weight: 500;font-size: 42px;padding-right: 138px"><%= (weight) ? weight : '' %></td>
          <td class="unit" style="height: 42px;">KG.</td>
        </tr>
        <tr class="split-row">
          <td colspan="3" style="height: 42px;">
            <div class="split-container">
              <div class="split-left">
                <div style="height: 100%;float: left;width: 60%;">
                    <span class="lbl" style="font-size: 21px;">DIAMETER</span>
                </div>
                
                <span class="value_top" style="font-size: 42px; font-weight: 500;"><%= (diameter) ? diameter : '' %></span>
                <span class="unit-bottom">IN.</span>
              </div>
              <div class="split-right">
                <div style="height: 100%;float: left;width: 2%;">
                    <span class="lbl" style="font-size: 21px;">DATE</span>
                </div>
                <span class="value_top" style="font-size: 42px;font-weight: 500;"><%= (date) ? date : '' %></span>
              </div>
            </div>
          </td>
        </tr>
      </table>
    </div>
    <div style="display: flex; justify-content: space-between; align-items: flex-start; border: 1px solid #000;border-top: 0; padding: 8px 12px 12px 12px; box-sizing: border-box; width: 100.2%; background: #ffffff;">
  
      <!-- ข้อความ ROLL NO ฝั่งซ้ายบน -->
      <div style="font-family: 'Times New Roman', Times, serif; font-size: 24px; font-weight: normal; color: #000000; line-height: 1;">
        ROLL NO
      </div>

      <!-- กลุ่มเนื้อหาฝั่งขวา (ตัวเลข + บาร์โค้ด) -->
      <div style="display: flex; flex-direction: column; align-items: flex-end;">
        <div style="font-family: Arial, Helvetica, sans-serif; font-size: 52px; font-weight: 549; line-height: 1; color: #000000; letter-spacing: 1px; margin-bottom: 6px;">
          <%= rollNo %>
        </div>
        <img src="<%= barcodeImg %>" alt="Barcode" style="width: 380px; height: 52px; object-fit: fill;">
      </div>

    </div>

    <!-- ==================== กล่องล่าง ==================== -->
  <!-- กล่องล่าง (แยกอิสระ) -->
  <div style="display: flex; width: 100%; border: 1px solid #000; box-sizing: border-box; margin-top: 15px; font-family: 'Times New Roman', Times, serif; background: #ffffff;">

    <!-- ฝั่งซ้าย: ตารางข้อมูล 5 บรรทัด -->
    <div style="width: 45%; border-right: 1px solid #000; box-sizing: border-box;">
      <table style="width: 100%; border-collapse: collapse; table-layout: fixed;">
        <!-- GRADE -->
        <tr style="border-bottom: 1px solid #000;">
          <td style="padding: 5px 8px; font-size: 18px; font-weight: normal; width: 38%;" class="left_a">GRADE</td>
          <td style="padding: 5px 4px; font-size: 20px; text-align: center;" class="center_a"><%= (grade) ? grade : '' %></td>
          <td style="padding: 5px 4px 2px 0; font-size: 11px; text-align: right; vertical-align: bottom; width: 35px;" class="right_a">GSM.</td>
        </tr>
        <!-- SIZE -->
        <tr style="border-bottom: 1px solid #000;">
          <td style="padding: 5px 8px; font-size: 18px; font-weight: normal;" class="left_a">SIZE</td>
          <td style="padding: 5px 4px; font-size: 20px; text-align: center;" class="center_a"><%= (size) ? size : '' %></td>
          <td style="padding: 5px 4px 2px 0; font-size: 11px; text-align: right; vertical-align: bottom;" class="right_a">IN.</td>
        </tr>
        <!-- DIAMETER -->
        <tr style="border-bottom: 1px solid #000;">
          <td style="padding: 5px 8px; font-size: 18px; font-weight: normal;" class="left_a">DIAMETER</td>
          <td style="padding: 5px 4px; font-size: 20px; text-align: center;" class="center_a"><%= (diameter) ? diameter : '' %></td>
          <td style="padding: 5px 4px 2px 0; font-size: 11px; text-align: right; vertical-align: bottom;" class="right_a">IN.</td>
        </tr>
        <!-- WEIGHT -->
        <tr style="border-bottom: 1px solid #000;">
          <td style="padding: 5px 8px; font-size: 18px; font-weight: normal;" class="left_a">WEIGHT</td>
          <td style="padding: 5px 4px; font-size: 20px; text-align: center;" class="center_a"><%= (weight) ? weight : '' %></td>
          <td style="padding: 5px 4px 2px 0; font-size: 11px; text-align: right; vertical-align: bottom;" class="right_a">KG.</td>
        </tr>
        <!-- DATE -->
        <tr>
          <td style="padding: 5px 8px; font-size: 18px; font-weight: normal;" class="left_a">DATE</td>
          <td style="padding: 5px 4px; font-size: 20px; text-align: center;" class="center_a"><%= (date) ? date : '' %></td>
          <td style="padding: 5px 4px 2px 0; font-size: 11px; text-align: right; vertical-align: bottom;" class="right_a"> </td>
        </tr>
      </table>
    </div>

    <!-- ฝั่งขวา: บาร์โค้ด + เลข Roll + ข้อความ HOLD -->
    <div style="width: 55%; display: flex; flex-direction: column; justify-content: center; align-items: center; padding: 12px; box-sizing: border-box;">
      <img src="<%= barcodeImg %>" alt="Barcode Mini" style="width: 230px; height: 38px; object-fit: fill;">
      <div style="font-size: 18px; margin-top: 4px; font-family: 'Times New Roman', Times, serif;"><%= rollNo %></div>
      <div style="font-size: 42px; font-weight: normal; font-family: 'Times New Roman', Times, serif; margin-top: 6px; letter-spacing: 1px;">
        *<%= status %>*
      </div>
    </div>

  </div>

  </div>

</body>
</html>
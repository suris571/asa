                <!-- ปุ่มกดสั่งการ -->
                <div class="custom-filter-item ml-auto">
                    <button type="button" class="btn btn-sm btn-primary font-weight-bold" id="btnDoQuery">
                        <i class="fas fa-search"></i> ค้นหาข้อมูล
                    </button>
                    <button type="button" class="btn btn-sm btn-default border font-weight-bold" id="btnClearQuery">
                        ล้างคำค้น
                    </button>
                </div>
            </div>

            <table id="splitSetTable" class="table table-bordered table-hover text-nowrap text-center align-middle w-100">
                <thead class="bg-light">
                    <tr>
                        <th rowspan="2" class="align-middle">เลขที่ใบสั่งผลิต</th>
                        <th rowspan="2" class="align-middle">ITEM</th>
                        <th colspan="4" class="text-center bg-gray-light">GRADE</th>
                        <th rowspan="2" class="align-middle">Set</th>
                        <th colspan="4" class="text-center bg-gray-light">ตั้งค่าใบมีด</th>
                        <th colspan="4" class="text-center bg-gray-light">Size นิ้ว</th>
                        <th rowspan="2" class="align-middle">ความยาว</th>
                        <th rowspan="2" class="align-middle">วันที่เสร็จ</th>
                        <th rowspan="2" class="align-middle">เวลา</th>
                        <th rowspan="2" class="align-middle">reel</th>
                        <th rowspan="2" class="align-middle">ปุ่มกด</th>
                        <th rowspan="2" class="align-middle">หมายเหตุ</th>
                    </tr>
                    <tr>
                        <!-- grade -->
                        <th>1</th><th>2</th><th>3</th><th>4</th>
                        <!-- ตั้งค่าใบมีด -->
                        <th>1</th><th>2</th><th>3</th><th>4</th>
                        <!-- Size นิ้ว -->
                        <th>1</th><th>2</th><th>3</th><th>4</th>
                    </tr>
                </thead>
                <tbody>
                    
                </tbody>
            </table>

            <div class="mt-3 text-right">
                <button type="button" class="btn btn-success font-weight-bold px-4" id="btnSaveAllRemark">
                    <i class="fas fa-save mr-1"></i> บันทึก
                </button>
            </div>
        </div>
        </div>

    </div>
  </section>
</div>
<%- include('./modal_qc') %>
<%- include('../partials/footer') %>

<script src="/plugins/datatables/jquery.dataTables.min.js"></script>
<script src="/plugins/datatables-bs4/js/dataTables.bootstrap4.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/moment@2.29.4/moment.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/daterangepicker/daterangepicker.min.js"></script>
<link rel="stylesheet" type="text/css" href="https://cdn.jsdelivr.net/npm/daterangepicker/daterangepicker.css" />
<script src="/socket.io/socket.io.js"></script>

<script>
  // 1. ประกาศตัวแปรและเปิดสายสัญญาณชั้นนอกสุดตามหลักสากล
  let queueTable;
  let qcModalTable; // ตารางบน Modal (#qcReelTable)
  let updateTimeout = null;
  const socket = io('/socket/wait-cut/qc-close-reel'); 

  // 🔒 ไม้ตายล้างท่อ: เคลียร์ Listener ตกค้างเก่าก่อนผูกใหม่ ป้องกันการยิงเบิ้ลในความจำ (Memory Leak)
  socket.off('connect');
  socket.off('disconnect');
  socket.off('update_queue_table');
  socket.off('queue_structure_changed');

  $(function () {
    // 2. ตั้งค่าการควบคุม DateRangePicker ให้ล็อกฟอร์แมต ค.ศ.
    $('.date-picker').daterangepicker({
        singleDatePicker: true,
        showDropdowns: true,
        autoUpdateInput: false,
        autoApply: false, // เปิดแถบปุ่มไว้เพื่อให้มีปุ่ม "ล้างค่า"
        locale: {
            format: 'YYYY-MM-DD',
            cancelLabel: 'ล้างค่า', 
            daysOfWeek: ['อา','จ','อ','พ','พฤ','ศ','ส'],
            monthNames: ['มกราคม','กุมภาพันธ์','มีนาคม','เมษายน','พฤษภาคม','มิถุนายน','กรกฎาคม','สิงหาคม','กันยายน','ตุลาคม','พฤศจิกายน','ธันวาคม'],
            firstDay: 1
        }
    });

    $('.date-picker').on('apply.daterangepicker', function(ev, picker) {
        $(this).val(picker.startDate.format('YYYY-MM-DD'));
        $(this).data('daterangepicker').hide(); // เลือกวันปุ๊บ สั่งซ่อนหน้าต่างทันที ไม่ต้องกดปุ่มตกลง
    });

    $('.date-picker').on('cancel.daterangepicker', function(ev, picker) {
        $(this).val(''); // เคลียร์กล่องข้อความอย่างเดียวตามสั่ง ไม่ยิง Query
    });

    // 3. จัดระเบียบสายสัญญาณ Socket Listeners ให้อยู่ในจังหวะที่ DOM พร้อมใช้งานอย่างปลอดภัย
    socket.on('connect', function() {
      $('#socketStatus').removeClass('bg-warning bg-danger').addClass('bg-success text-white').text('🟢 เชื่อมต่อเรียลไทม์ปกติ');
    });

    socket.on('disconnect', function() {
      $('#socketStatus').removeClass('bg-success bg-warning').addClass('bg-danger text-white').text('🔴 การเชื่อมต่อหลุด (ข้อมูลอาจไม่อัปเดต)');
    });
    

    
    socket.on('queue_structure_changed', function(res) {
        if (res && res.success) {
            fetchFilteredQueue(); 
        }
    });

    // 4. ดึงข้อมูลชุดแรกจาก Server มาเรนเดอร์ตารางตอนเปิดหน้าเว็บ
    const serverData = <%- JSON.stringify(orders) %>;
    queueTable = $('#splitSetTable').DataTable({
        "paging": true,
        "pageLength": 25,
        "searching": true,
        "ordering": false,
        "data": serverData, // ข้อมูล Array ที่ยิงมาจาก View หลังบ้าน
        "columns": [
            { "data": "order_no" },          // เลขที่ใบสั่งผลิต (เช่น 0065/2026)
            { "data": "orderItem" },        // ITEM (เช่น 1, 2)
            
            { "data": "grade1" },
            { "data": "grade2" },
            { "data": "grade3" },
            { "data": "grade4" },
            { 
                "data": "set",            // 🎯 คอลัมน์ set_no จาก pl_cut_split_set (เช่น 1/6, 2/6)
                "render": function(data) {
                    return `<span class="font-weight-bold text-primary">${data || '-'}</span>`;
                }
            },
            // --- ตั้งค่าใบมีด ---
            { "data": "blad1", "defaultContent": "" },
            { "data": "blad2", "defaultContent": "" },
            { "data": "blad3", "defaultContent": "" },
            { "data": "blad4", "defaultContent": "" },
            // --- Size นิ้ว ---
            { "data": "size1", "defaultContent": "" },
            { "data": "size2", "defaultContent": "" },
            { "data": "size3", "defaultContent": "" },
            { "data": "size4", "defaultContent": "" },
            // --- ความยาว ---
            { 
                "data": "lenght",        // 🎯 ความยาวสั่งตัดจาก pl_cut_split_set
                "render": function(data) {
                    return data ? Number(data).toLocaleString() : '';
                }
            },
            
            { "data": "date", "defaultContent": "" },
            { "data": "time", "defaultContent": "" },
            { "data": "reel_no", "defaultContent": "" },
            {
                "data": null,
                "render": function(data, type, row) {
                    // ปุ่ม Reset
                    return `<button class="btn btn-sm btn-warning text-white font-weight-bold btn-block" 
                            onclick="actionQC(${row.split_set_id})">QC</button>`;
                }
            },
            {
                data: "remark",
                defaultContent: "",
                render: function (data, type, row) {
                    // 🎯 ถ้าเป็นการ Render เพื่อแสดงผลในตาราง (type === 'display')
                    if (type === 'display') {
                        const remarkValue = data ? data : '';
                        
                        // 🎯 คาย <input type="text"> ออกมา พร้อมใส่ value และ data-id (ดึงจาก row.id)
                        return `<input type="text" 
                                    class="form-control form-control-sm remark-input" 
                                    data-id="${row.split_set_id}" 
                                    value="${remarkValue}" 
                                    placeholder="ระบุหมายเหตุ...">`;
                    }
                    // ถ้าเป็นประเภทอื่น (เช่น sort, filter) ให้คายค่า data ปกติออกไป
                    return data;
                }
            }
        ],
        "createdRow": function(row, data, dataIndex) {
            // ผูก Primary Key ของตาราง pl_cut_split_set ไว้ที่แถว
            $(row).attr('data-split-id', data.splitSetId);
        }
    });
    

    socket.on('update_queue_table', function(res) {
        hideLoader();
        if (!res || !res.success || !res.data) return;
        
        if (queueTable) {
           queueTable.clear().rows.add(res.data).draw(false);
        }
    });

    // ปรับสัดส่วนตารางเมื่อกดปุ่มย่อ/ขยายแถบเมนูด้านซ้าย
    $('[data-widget="pushmenu"]').on('click', function() {
        setTimeout(function() {
            if (queueTable) {
                queueTable.columns.adjust().draw(false);
            }
        }, 350);
    });

    // ผูกคำสั่งกับปุ่มกดค้นหาหลักของระบบ
    $('#btnDoQuery').on('click', function() {
        fetchFilteredQueue();
    });

    // ผูกคำสั่งกับปุ่มล้างคำค้น
    $('#btnClearQuery').on('click', function() {
        $('#filterMinDate').val('');
        $('#filterMaxDate').val('');
        $('#searchStatus').val('');
        $('#searchOrderNo').val('');
        fetchFilteredQueue(); 
    });


    $('#btnSaveAllRemark').on('click', async function() {
        const payloadList = [];

        // 🎯 1. วนลูปตรวจทุกช่อง .remark-input ในตาราง (รวมถึงหน้าที่โดน Pagination ซ่อนอยู่ถ้าใช้ DataTables)
        $('.remark-input').each(function() {
            const input = $(this);
            const id = input.data('id');
            const remarkVal = input.val().trim();

            // 🎯 2. กรองเอาเฉพาะแถวที่มีการกรอกข้อความ (ไม่เป็นค่าว่าง)
            if (remarkVal !== '') {
                payloadList.push({
                    id: id,
                    remark: remarkVal
                });
            }
        });

        console.log("📤 รายการที่จะส่งไปอัปเดต:", payloadList);
        if (payloadList.length === 0) {
            alert('กรุณากรอกหมายเหตุอย่างน้อย 1 รายการก่อนกดบันทึกครับ');
            return;
        }
        try {
            // 🎯 4. ส่ง Array ก้อนนี้ไปหา Backend (พอร์ต 3000)
            const response = await $.ajax({
                url: '/wait-cut/qc-close-reel/save-remark',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify({ items: payloadList })
            });

            if (response.success) {
                alert(`✅ บันทึกหมายเหตุสำเร็จ ${payloadList.length} รายการ!`);
                // โหลดตารางใหม่ หรืออัปเดตสถานะหน้าจอ
            } else {
                alert('❌ เกิดข้อผิดพลาด: ' + response.message);
            }

        } catch (err) {
            console.error("💥 ยิงอัปเดต Remark ล้มเหลว:", err);
            alert('ไม่สามารถเชื่อมต่อเซิร์ฟเวอร์ได้');
        }
    });

    qcModalTable = $('#qcReelTable').DataTable({
        paging: true,
        pageLength: 10,
        lengthChange: false,
        searching: false,
        ordering: false,
        info: false,
        autoWidth: false,
        columns: [
            { "data": "REEL_NO", "defaultContent": "-" },
            { "data": "GRADE", "defaultContent": "-" },
            { "data": "date", "defaultContent": "-" },
            { 
                "data": "STATUS", 
                "defaultContent": "-",
                "render": function(data) {
                    return `<span class="badge badge-success">${data}</span>`;
                }
            },
            { "data": "DCS_REEL_NO", "defaultContent": "-" }
        ],
        createdRow: function(row, data, dataIndex) {
            // 🎯 แก้ให้คลีน เหลือแค่ data.ID
            $(row).attr('data-id', data.ID || '');
        }
    });


    $('#qcReelTable tbody').on('click', 'tr', function () {
        const rowData = qcModalTable.row(this).data();
        
        if (rowData) {
            $('#qcReelTable tbody tr').removeClass('selected-reel-row table-warning');
            $(this).addClass('selected-reel-row table-warning');

            // 🎯 ดึง ID ตัวพิมพ์ใหญ่ยัดใส่ Hidden Input
            $('#selectedReelId').val(rowData.ID);

            $('#btnModalConfirm').prop('disabled', false);

            // 🎯 แก้ตรงนี้เป็น rowData.ID (ตัวพิมพ์ใหญ่) และเพิ่มแสดง REEL_NO ด้วย
            console.log(`📌 เลือก Reel No: ${rowData.REEL_NO} (ID: ${rowData.ID}) สำหรับ SplitSetId: ${$('#selectedSplitSetId').val()}`);
        }
    });


    $('#btnModalSearch').on('click', function() {
        loadQcReelData();
    });

    // 🟢 2. เมื่อพิมพ์ในกล่องค้นหา #modalSearchReelNo แล้วกดปุ่ม Enter
    $('#modalSearchReelNo').on('keypress', function(e) {
        if (e.which === 13) { // 13 คือปุ่ม Enter
            e.preventDefault(); // ป้องกันไม่ให้ Form submit หน้าเว็บใหม่
            loadQcReelData();
        }
    });
    

  }); //ready function
  
    function fetchFilteredQueue() {
        const rawStartDate = $('#filterMinDate').val() ? $('#filterMinDate').val().trim() : '';
        const rawEndDate = $('#filterMaxDate').val() ? $('#filterMaxDate').val().trim() : '';

        const filterParams = {
            startDate: rawStartDate !== '' ? rawStartDate : null,
            endDate: rawEndDate !== '' ? rawEndDate : null
        };

        console.log("🚀 [Client Request] ยิงเงื่อนไขไป Query บนหลังบ้าน:", filterParams);
        socket.emit('get_filtered_queue', filterParams);
    }

    // เผื่อฟังก์ชันปุ่มสถานะอื่นๆ รอไว้ไม่ให้เกิดข้อผิดพลาด
    function actionQC(split_set_id) {
        $('#selectedSplitSetId').val(split_set_id);
    
        // รีเซ็ตค่าการเลือกเดิม
        $('#selectedReelId').val('');
        $('#selectedReelNo').val('');
        $('#btnModalConfirm').prop('disabled', true); // ปิดปุ่มตกลงไว้ก่อนจนกว่าจะเลือกแถว
        
        // โหลดข้อมูล Reel ครั้งแรกใส่ Modal
        loadQcReelData();

        // เปิด Modal เด้งขึ้นมา
        $('#qcReelModal').modal('show');
    }

    $('#qcReelModal').on('shown.bs.modal', function () {
        if (qcModalTable) {
            // 🎯 บังคับคำนวณความกว้างคอลัมน์ใหม่ให้เป๊ะทันทีที่ Modal แสดงผล
            qcModalTable.columns.adjust().draw();
        }
    });

    $('#btnModalConfirm').on('click', function () {
        saveQcReelSelection();
    });

    function loadQcReelData() {
        // 🎯 ดึงคำค้นหาจากช่องค้นหาใน Modal (ถ้าไม่มีค่า ให้ส่ง '%' ไปดึงทั้งหมด)
        const keyword = $('#modalSearchReelNo').val() ? $('#modalSearchReelNo').val().trim() : '%';
        console.log("========================uuuu=ddhdddhdhhdhdhd"+keyword)
        if(!keyword || keyword == "%"){
            return;
        }
        // (Optional) เปิด Loading Overlay ถ้ามี
        if (typeof showLoader === 'function') showLoader();

        // 🚀 ยิง AJAX ไปดึงข้อมูลจาก API หลังบ้าน
        $.ajax({
            url: '/wait-cut/qc-close-reel/getModal-reel', // 🎯 ปรับ URL ให้ตรงกับ Route หลังบ้านของกัปตัน
            type: 'GET',
            data: { search: keyword },
            dataType: 'json',
            success: function (response) {
                if (typeof hideLoader === 'function') hideLoader();

                if (response && response.success && Array.isArray(response.data)) {
                    
                    // 🛑 1. ปิดปุ่ม "ตกลง" และเคลียร์ค่ารายการที่เลือกเดิมก่อน
                    selectedReelData = null;
                    $('#btnModalConfirm').prop('disabled', true);

                    // 🎯 2. ล้างข้อมูลเก่า และนำข้อมูลใหม่ยัดใส่ DataTables บน Modal
                    if (qcModalTable) {
                        qcModalTable.clear().rows.add(response.data).draw();
                    }

                    console.log(`✅ โหลดข้อมูล Reel สำเร็จ: ${response.data.length} รายการ`);

                } else {
                    alert('❌ ไม่สามารถดึงข้อมูล Reel ได้: ' + (response.message || 'รูปแบบข้อมูลไม่ถูกต้อง'));
                }
            },
            error: function (xhr, status, error) {
                if (typeof hideLoader === 'function') hideLoader();
                console.error("💥 AJAX Error [loadQcReelData]:", error);
                alert('ไม่สามารถเชื่อมต่อเซิร์ฟเวอร์เพื่อดึงข้อมูล Reel ได้');
            }
        });
    }


    async function saveQcReelSelection() {
        const splitSetId = $('#selectedSplitSetId').val();
        const reelId = $('#selectedReelId').val();

        if (!splitSetId || !reelId) {
            alert('กรุณาเลือกรายการ Reel ก่อนกดบันทึกครับ');
            return;
        }

        const payload = {
            splitSetId: splitSetId,
            reelId: reelId
        };

        if (typeof showLoader === 'function') showLoader();

        try {
            const response = await $.ajax({
                url: '/wait-cut/qc-close-reel/save-reel',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(payload)
            });

            if (typeof hideLoader === 'function') hideLoader();

            if (response && response.success) {
                alert('✅ บันทึกเลือก Reel สำเร็จ!');
                const targetRow = queueTable.row(function (idx, data, node) {
                    return data.split_set_id == splitSetId;
                });

                if (targetRow.length) {
                    const rowData = targetRow.data();
                    rowData.reel_id = reelId; 
                    
                    if (response.reelNo) {
                        rowData.reel_no = response.reelNo; // อัปเดตชื่อ Reel No ไว้แสดงผล
                    }
                    targetRow.data(rowData).draw(false);
                }

                // ปิด Modal
                $('#qcReelModal').modal('hide');

            } else {
                alert('❌ เกิดข้อผิดพลาด: ' + (response.message || 'ไม่สามารถบันทึกข้อมูลได้'));
            }

        } catch (err) {
            if (typeof hideLoader === 'function') hideLoader();
            console.error("💥 Error [saveQcReelSelection]:", err);
            alert('ไม่สามารถเชื่อมต่อเซิร์ฟเวอร์เพื่อบันทึกข้อมูลได้');
        }
    }

    function showLoader() {
        // ล็อกหน้าจอทันที พนักงานจะคลิกปุ่มใดๆ ในตารางซ้ำไม่ได้เลย
        $('#pageLoader').fadeIn(150); 
    }

    function hideLoader() {
        // ปลดล็อกหน้าจอเมื่อทำงานเสร็จ
        $('#pageLoader').fadeOut(150);
    }
</script>
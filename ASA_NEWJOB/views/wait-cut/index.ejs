<%- include('../partials/header') %>
<%- include('../partials/sidebar') %>

<style>
  /* 1. บังคับแผงควบคุมชั้นนอกสุดให้เรียงตัวเป็นแนวขวางบรรทัดเดียว ไม่ให้หักหล่น */
  .dataTables_wrapper .row:first-child {
      display: flex !important;
      flex-direction: row !important;
      flex-wrap: nowrap !important; 
      /* 🔒 ล็อกห้ามขึ้นบรรทัดใหม่เด็ดขาด */
      justify-content: space-between !important;
      align-items: center !important;
      width: 100% !important;
      margin: 0 0 12px 0 !important;
      padding: 0 !important;
  }

  /* 2. ดักล้างค่าความกว้างดีฟอลต์ของระบบเก่าที่แอบบีบพื้นที่ */
  .dataTables_wrapper .row:first-child > div {
      flex: 0 0 auto !important;
      max-width: auto !important;
      width: auto !important;
      padding: 0 !important;
  }


  #queueTable {
    width: 100% !important;
    min-width: 1200px !important; /* 🔥 ไม้ตาย: ล็อกฐานความกว้างขั้นต่ำไว้ ถ้าจอเล็กลงกว่านี้ค่อยขึ้น Scrollbar จะไม่มีวันบี้! */
    table-layout: auto !important;
}

/* 🔒 จัดระเบียบปุ่มคอลัมน์สุดท้าย ไม่ให้มันกางเป็นหน้ากระดานยาวเกินไป */




  /* 3. จัดการฝั่งซ้าย (Dropdown เลือกจำนวนหน้า) */
  .dataTables_length {
      display: block !important;
      text-align: left !important;
      float: none !important; /* ล้างค่า Float ตั้งต้น */
  }
  .dataTables_length label {
      display: inline-flex !important;
      align-items: center !important;
      white-space: nowrap !important;
      font-weight: bold;
      color: #495057;
      margin: 0 !important;
  }
  .dataTables_length select {
      width: 75px !important;
      height: 31px !important;
      margin: 0 8px !important;
      padding: 2px 6px !important;
      font-size: 0.875rem;
      border-radius: 0.25rem;
      border: 1px solid #ced4da;
  }

  /* 4. จัดการฝั่งขวา (ช่องค้นหาบาร์โค้ด) */
  .dataTables_filter {
      display: block !important;
      text-align: right !important;
      float: none !important; /* ล้างค่า Float ตั้งต้น */
      margin: 0 !important; /* ดึงมาร์จินออกป้องกันมันดีดตัวสไลด์ลง */
  }
  .dataTables_filter label {
      display: inline-flex !important;
      align-items: center !important;
      white-space: nowrap !important;
      font-weight: bold;
      color: #495057;
      margin: 0 !important;
  }
  .dataTables_filter input {
      width: 250px !important;
      height: 31px !important;
      margin-left: 8px !important;
      padding: 4px 8px !important;
      font-size: 0.875rem;
      border-radius: 0.25rem;
      border: 1px solid #ced4da;
  }
  .dataTables_filter input:focus {
      border-color: #80bdff;
      outline: 0;
      box-shadow: 0 0 0 0.2rem rgba(0,123,255,.25);
  }

  #queueTable td:last-child {
        white-space: nowrap !important;
        width: 1% !important; /* ไม้ตาย: บังคับให้ขยายตามขนาด Content จริงข้างใน */
    }

  .custom-filter-container {
      display: flex;
      flex-wrap: wrap;
      gap: 15px;
      margin-bottom: 15px;
      padding: 12px;
      background-color: #f8f9fa;
      border: 1px solid #dee2e6;
      border-radius: 0.25rem;
      align-items: center;
  }
  .custom-filter-item {
      display: flex;
      align-items: center;
      gap: 8px;
  }
  .custom-filter-item label {
      margin: 0;
      font-weight: bold;
      color: #495057;
      white-space: nowrap;
      font-size: 0.875rem;
  }
  .custom-filter-item input, .custom-filter-item select {
      height: 31px;
      padding: 4px 8px;
      font-size: 0.875rem;
      border-radius: 0.25rem;
      border: 1px solid #ced4da;
  }
    .custom-filter-item input.date-picker {
        width: 150px;
    }
    .custom-filter-item input[type="text"], .custom-filter-item select {
        width: 180px;
    }
    .custom-filter-item input:focus, .custom-filter-item select:focus {
        border-color: #80bdff;
        outline: 0;
    }
  
</style>

<div class="content-wrapper">
  <section class="content-header">
    <div class="container-fluid">
      <div class="row mb-2">
        <div class="col-sm-6">
          <h1>ระบบจัดการคิวงาน</h1>
        </div>
      </div>
    </div>
  </section>

  <section class="content">
    <div class="container-fluid">
      
        <div class="card">
        <div class="card-header bg-navy">
            <h3 class="card-title font-weight-bold">📋 ระบบจัดการคิวงานสั่งตัดและตั้งค่าใบมีด</h3>
            <div class="card-tools">
            <span id="socketStatus" class="badge bg-warning text-dark">🟡 กำลังเตรียมเชื่อมต่อ...</span>
            </div>
        </div>
        <div class="card-body p-2" style="overflow-x: auto;">

            <div class="custom-filter-container">
            <!-- 1. ช่วงวันที่ผลิตเสร็จ -->
                <div class="custom-filter-item">
                    <label>📅 วันที่ผลิตเสร็จ:</label>
                    <!-- เปลี่ยนเป็น type="text" และใส่คลาส date-picker พร้อมเปิด readonly ดักไว้ -->
                    <input type="text" id="filterMinDate" class="form-control form-control-sm date-picker" placeholder="YYYY-MM-DD" readonly>
                    <label>ถึง</label>
                    <input type="text" id="filterMaxDate" class="form-control form-control-sm date-picker" placeholder="YYYY-MM-DD" readonly>
                </div>
                
                <!-- 2. สถานะ -->
                <div class="custom-filter-item">
                    <label for="searchStatus">🚦 สถานะ:</label>
                    <select id="searchStatus">
                        <option value="">-- ทั้งหมด --</option>
                        <option value="ดำเนินการ">ดำเนินการ</option>
                        <option value="รอตัด">รอตัด</option>
                        <option value="HOLD">HOLD</option>
                        <option value="เสร็จสิ้น">เสร็จสิ้น</option>
                    </select>
                </div>

                <!-- 3. เลขที่ใบสั่งผลิต -->
                <div class="custom-filter-item">
                    <label for="searchOrderNo">🔍 เลขที่ใบสั่งผลิต:</label>
                    <input type="text" id="searchOrderNo" placeholder="พิมพ์เลขที่ใบสั่งผลิต...">
                </div>

                <!-- ปุ่มกดสั่งการ -->
                <div class="custom-filter-item ml-auto">
                    <button type="button" class="btn btn-sm btn-primary font-weight-bold" id="btnDoQuery">
                        <i class="fas fa-search"></i> ค้นหาข้อมูล
                    </button>
                    <button type="button" class="btn btn-sm btn-default border font-weight-bold" id="btnClearQuery">
                        ล้างคำค้น
                    </button>
                </div>
            </div>

            <table id="queueTable" class="table table-bordered table-hover text-nowrap text-center align-middle">
            <thead class="bg-light">
                <tr>
                <th rowspan="2" class="align-middle">ลำดับ</th>
                <th rowspan="2" class="align-middle">เลขที่ใบสั่งผลิต</th>
                <th rowspan="2" class="align-middle">ITEM</th>
                <th rowspan="2" class="align-middle">Grade</th>
                <th rowspan="2" class="align-middle">Set</th>
                <th colspan="4" class="text-center bg-gray-light">ตั้งค่าใบมีด</th>
                <th colspan="4" class="text-center bg-gray-light">Size นิ้ว</th>
                <th rowspan="2" class="align-middle">วันที่เสร็จ</th>
                <th rowspan="2" class="align-middle">เวลา</th>
                <th rowspan="2" class="align-middle">ลูก</th>
                <th rowspan="2" class="align-middle">Set</th>
                <th rowspan="2" class="align-middle">สถานะ</th>
                <th rowspan="2" class="align-middle bg-navy">ปุ่มกดจัดการคิวงาน</th>
                </tr>
                <tr>
                <th>1</th><th>2</th><th>3</th><th>4</th>
                <th>1</th><th>2</th><th>3</th><th>4</th>
                </tr>
            </thead>
            <tbody>
            </tbody>
            </table>
        </div>
        </div>

    </div>
  </section>
</div>

<%- include('../partials/footer') %>

<script src="/plugins/datatables/jquery.dataTables.min.js"></script>
<script src="/plugins/datatables-bs4/js/dataTables.bootstrap4.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/moment@2.29.4/moment.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/daterangepicker/daterangepicker.min.js"></script>
<link rel="stylesheet" type="text/css" href="https://cdn.jsdelivr.net/npm/daterangepicker/daterangepicker.css" />
<script src="/socket.io/socket.io.js"></script>

<script>
  // 1. ประกาศตัวแปรและเปิดสายสัญญาณชั้นนอกสุดตามหลักสากล
  let queueTable;
  const socket = io('/socket/wait-cut'); 

  // 🔒 ไม้ตายล้างท่อ: เคลียร์ Listener ตกค้างเก่าก่อนผูกใหม่ ป้องกันการยิงเบิ้ลในความจำ (Memory Leak)
  socket.off('connect');
  socket.off('disconnect');
  socket.off('update_queue_table');
  socket.off('queue_structure_changed');

  $(function () {
    // 2. ตั้งค่าการควบคุม DateRangePicker ให้ล็อกฟอร์แมต ค.ศ.
    $('.date-picker').daterangepicker({
        singleDatePicker: true,
        showDropdowns: true,
        autoUpdateInput: false,
        autoApply: false, // เปิดแถบปุ่มไว้เพื่อให้มีปุ่ม "ล้างค่า"
        locale: {
            format: 'YYYY-MM-DD',
            cancelLabel: 'ล้างค่า', 
            daysOfWeek: ['อา','จ','อ','พ','พฤ','ศ','ส'],
            monthNames: ['มกราคม','กุมภาพันธ์','มีนาคม','เมษายน','พฤษภาคม','มิถุนายน','กรกฎาคม','สิงหาคม','กันยายน','ตุลาคม','พฤศจิกายน','ธันวาคม'],
            firstDay: 1
        }
    });

    $('.date-picker').on('apply.daterangepicker', function(ev, picker) {
        $(this).val(picker.startDate.format('YYYY-MM-DD'));
        $(this).data('daterangepicker').hide(); // เลือกวันปุ๊บ สั่งซ่อนหน้าต่างทันที ไม่ต้องกดปุ่มตกลง
    });

    $('.date-picker').on('cancel.daterangepicker', function(ev, picker) {
        $(this).val(''); // เคลียร์กล่องข้อความอย่างเดียวตามสั่ง ไม่ยิง Query
    });

    // 3. จัดระเบียบสายสัญญาณ Socket Listeners ให้อยู่ในจังหวะที่ DOM พร้อมใช้งานอย่างปลอดภัย
    socket.on('connect', function() {
      $('#socketStatus').removeClass('bg-warning bg-danger').addClass('bg-success text-white').text('🟢 เชื่อมต่อเรียลไทม์ปกติ');
    });

    socket.on('disconnect', function() {
      $('#socketStatus').removeClass('bg-success bg-warning').addClass('bg-danger text-white').text('🔴 การเชื่อมต่อหลุด (ข้อมูลอาจไม่อัปเดต)');
    });

    socket.on('update_queue_table', function(res) {
        console.log("📥 [RenderMoveQue] อัปเดตข้อมูลยกล็อตด้วยวิธีล้างและแอดใหม่ (ล็อกสถานะ)");
        if (!res || !res.success || !res.data) return;

        // ดักเช็กความพร้อมของตัวแปรตารางก่อนลุยงาน
        if (queueTable) {
            queueTable.clear();
            queueTable.rows.add(res.data);
            queueTable.draw(false); // ใส่ false เพื่อล็อกหน้าเพจ (Pagination) เดิมของพนักงานไว้ ไม่ให้เด้งกลับหน้าแรก
            console.log("✨ วาดโครงสร้างตารางใหม่ยกล็อตสำเร็จ แถวเรียงตรงตามฐานข้อมูล 100%!");
        }
    });

    socket.on('queue_structure_changed', function(res) {
        console.log("🔔 สัญญาณเตือนภัยคิวเปลี่ยน: ทำการสั่งดาวน์โหลดข้อมูลตามฟิลเตอร์ปัจจุบันของตัวเองทันที!");
        if (res && res.success) {
            fetchFilteredQueue(); 
        }
    });

    // 4. ดึงข้อมูลชุดแรกจาก Server มาเรนเดอร์ตารางตอนเปิดหน้าเว็บ
    const serverData = <%- JSON.stringify(orders) %>;

    queueTable = $('#queueTable').DataTable({
        "paging": true,
        "pageLength": 25,
        "searching": true,
        "ordering": false,
        "data": serverData,
        "columns": [
            { "data": "number" },
            { "data": "orderNo" },
            { "data": "orderItem" },
            { "data": "grade1" },
            { "data": null , "defaultContent": "-" },
            { "data": "blad1", "defaultContent": "" },
            { "data": "blad2", "defaultContent": "" },
            { "data": "blad3", "defaultContent": "" },
            { "data": "blad4", "defaultContent": "" },
            { "data": "size1", "defaultContent": "" },
            { "data": "size2", "defaultContent": "" },
            { "data": "size3", "defaultContent": "" },
            { "data": "size4", "defaultContent": "" },
            { "data": "finishDate", "defaultContent": "" },
            { "data": "finishTime", "defaultContent": "" },
            { "data": "diameter", "defaultContent": "" },
            { "data": null, "defaultContent": "" },
            { 
              "data": "status",
              "render": function(data) {
                  let badgeClass = 'bg-warning text-dark';
                  if (data === 'HOLD') badgeClass = 'bg-secondary';
                  if (data === 'เสร็จสิ้น') badgeClass = 'bg-success';
                  return `<span class="badge ${badgeClass}">${data}</span>`;
              }
            },
            {
    "data": null,
    "render": function(data, type, row) {
        if (row.status === 'เสร็จสิ้น') {
          return `<button class="btn btn-sm btn-outline-secondary" disabled>สิ้นสุดกระบวนการ</button>`;
        }

        // กำหนดสไตล์สีตามแบบฉบับคุมโทน
        const styleCut = 'background-color: #3b7ddd !important; border-color: #3b7ddd !important; color: #fff !important;';
        const styleQueue = 'background-color: #f1f3f5 !important; border-color: #ced4da !important; color: #343a40 !important;';

        return `
        <div class="d-flex flex-nowrap align-items-center justify-content-center">
            
            <!-- 1. ปุ่มหลัก: สั่งตัด -->
            <button class="btn btn-sm font-weight-bold mr-2" style="${styleCut}" onclick="actionCut(${row.id})">สั่งตัด</button>
            
            <!-- 2. ปุ่มจัดการงาน (Dropdown): ย้ายมาไว้อันดับสองตามสั่ง -->
            <div class="dropdown d-inline-block mr-2">
                <button class="btn btn-sm btn-default border dropdown-toggle font-weight-bold" type="button" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                    จัดการงาน
                </button>
                <div class="dropdown-menu dropdown-menu-right shadow">
                    <a class="dropdown-menu-item p-2 d-block text-secondary font-weight-bold" href="#" onclick="actionHold(${row.id}); return false;"><i class="fas fa-pause mr-2 text-muted"></i> HOLD งาน</a>
                    <a class="dropdown-menu-item p-2 d-block text-dark font-weight-bold" href="#" onclick="actionUnhold(${row.id}); return false;"><i class="fas fa-unlock mr-2 text-muted"></i> ปลด HOLD</a>
                    <div class="dropdown-divider"></div>
                    <a class="dropdown-menu-item p-2 d-block text-success font-weight-bold" href="#" onclick="actionSuccess(${row.id}); return false;"><i class="fas fa-check mr-2"></i> งานเสร็จสิ้น</a>
                    <div class="dropdown-divider"></div>
                    <a class="dropdown-menu-item p-2 d-block text-danger font-weight-bold" href="#" onclick="actionReset(${row.id}); return false;"><i class="fas fa-undo mr-2"></i> Reset ระบบ</a>
                </div>
            </div>

            <!-- 3. ปุ่มขยับคิว: ย้ายไปอยู่ท้ายสุดเป็นระเบียบเรียบร้อย -->
            <div class="btn-group">
                <button class="btn btn-sm" style="${styleQueue}" onclick="moveUp(${row.id},${row.que})" title="เลื่อนคิวขึ้น"><i class="fas fa-chevron-up"></i></button>
                <button class="btn btn-sm" style="${styleQueue}" onclick="moveDown(${row.id},${row.que})" title="เลื่อนคิวลง"><i class="fas fa-chevron-down"></i></button>
            </div>

        </div>
        `;
    }
}
        ],
        "createdRow": function(row, data, dataIndex) {
            $(row).attr('data-id', data.id);
            $(row).attr('data-queue', data.que); 
        }
    });

    // ปรับสัดส่วนตารางเมื่อกดปุ่มย่อ/ขยายแถบเมนูด้านซ้าย
    $('[data-widget="pushmenu"]').on('click', function() {
        setTimeout(function() {
            if (queueTable) {
                queueTable.columns.adjust().draw(false);
            }
        }, 350);
    });

    // ผูกคำสั่งกับปุ่มกดค้นหาหลักของระบบ
    $('#btnDoQuery').on('click', function() {
        fetchFilteredQueue();
    });

    // ผูกคำสั่งกับปุ่มล้างคำค้น
    $('#btnClearQuery').on('click', function() {
        $('#filterMinDate').val('');
        $('#filterMaxDate').val('');
        $('#searchStatus').val('');
        $('#searchOrderNo').val('');
        fetchFilteredQueue(); 
    });
  });

  // 5. โดดออกมาสร้างฟังก์ชันหลักนอก Ready block เพื่อให้โครงสร้างปุ่มกด (onclick) ดึงไปทำงานได้แม่นยำ
  function moveUp(myId, myQueue) {
      const allData = queueTable.rows({ order: 'applied' }).data().toArray();
      const myIndex = allData.findIndex(row => Number(row.id) === Number(myId));

      if (myIndex === 0) {
          alert('งานนี้อยู่บนสุดของรายการทั้งหมดแล้ว ไม่สามารถขยับขึ้นได้อีก!');
          return;
      }

      const upperRowData = allData[myIndex - 1];
      const aboveId = upperRowData.id;
      const aboveQueue = upperRowData.que; // 🎯 แก้ไข: เปลี่ยนมาส่งฟิลด์ .que ซึ่งเป็นเลขคิวจริงใน DB แทนการใช้ลำดับหน้าจอ

      console.log(`🔼 [Client Request Mode] สลับคิวขึ้น: ID ${myId} (คิว ${myQueue}) -> แทนที่แถวบน ID ${aboveId} (คิว ${aboveQueue})`);

      socket.emit('swapQueue', {
          orderId: myId,
          current_que: myQueue,
          aboveOrderId: aboveId,
          above_que: aboveQueue
      });
  }

  function moveDown(myId, myQueue) {
      const allData = queueTable.rows({ order: 'applied' }).data().toArray();
      const myIndex = allData.findIndex(row => Number(row.id) === Number(myId));

      if (myIndex === allData.length - 1) {
          alert('งานนี้อยู่ล่างสุดของรายการทั้งหมดแล้ว ไม่สามารถขยับลงได้อีก!');
          return;
      }

      const lowerRowData = allData[myIndex + 1];
      const belowId = lowerRowData.id;
      const belowQueue = lowerRowData.que; // 🎯 แก้ไข: เปลี่ยนมาส่งฟิลด์ .que ซึ่งเป็นเลขคิวจริงใน DB แทนการใช้ลำดับหน้าจอ

      console.log(`🔽 [Client Request Mode] สลับคิวลง: ID ${myId} (คิว ${myQueue}) -> แทนที่แถวล่าง ID ${belowId} (คิว ${belowQueue})`);

      socket.emit('swapQueue', {
          orderId: myId,
          current_que: myQueue,
          aboveOrderId: belowId,
          above_que: belowQueue
      });
  }

  function fetchFilteredQueue() {
      const rawStartDate = $('#filterMinDate').val() ? $('#filterMinDate').val().trim() : '';
      const rawEndDate = $('#filterMaxDate').val() ? $('#filterMaxDate').val().trim() : '';

      const filterParams = {
          startDate: rawStartDate !== '' ? rawStartDate : null,
          endDate: rawEndDate !== '' ? rawEndDate : null,
          status: $('#searchStatus').val() || null,
          orderNo: $('#searchOrderNo').val() ? $('#searchOrderNo').val().trim() : null
      };

      console.log("🚀 [Client Request] ยิงเงื่อนไขไป Query บนหลังบ้าน:", filterParams);
      socket.emit('get_filtered_queue', filterParams);
  }

  // เผื่อฟังก์ชันปุ่มสถานะอื่นๆ รอไว้ไม่ให้เกิดข้อผิดพลาด
  function actionCut(id) { console.log('สั่งตัด:', id); }
  function actionHold(id) { console.log('HOLD:', id); }
  function actionUnhold(id) { console.log('ปลด HOLD:', id); }
  function actionSuccess(id) { console.log('เสร็จสิ้น:', id); }
  function actionReset(id) { console.log('Reset:', id); }
</script>
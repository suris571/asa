<%- include('../partials/header') %>
<%- include('../partials/sidebar') %>

<style>
  /* 1. บังคับแผงควบคุมชั้นนอกสุดให้เรียงตัวเป็นแนวขวางบรรทัดเดียว ไม่ให้หักหล่น */
  .dataTables_wrapper .row:first-child {
      display: flex !important;
      flex-direction: row !important;
      flex-wrap: nowrap !important; 
      /* 🔒 ล็อกห้ามขึ้นบรรทัดใหม่เด็ดขาด */
      justify-content: space-between !important;
      align-items: center !important;
      width: 100% !important;
      margin: 0 0 12px 0 !important;
      padding: 0 !important;
  }

  /* 2. ดักล้างค่าความกว้างดีฟอลต์ของระบบเก่าที่แอบบีบพื้นที่ */
  .dataTables_wrapper .row:first-child > div {
      flex: 0 0 auto !important;
      max-width: auto !important;
      width: auto !important;
      padding: 0 !important;
  }


  #queueTable {
    width: 100% !important;
    min-width: 1200px !important; /* 🔥 ไม้ตาย: ล็อกฐานความกว้างขั้นต่ำไว้ ถ้าจอเล็กลงกว่านี้ค่อยขึ้น Scrollbar จะไม่มีวันบี้! */
    table-layout: auto !important;
}

/* 🔒 จัดระเบียบปุ่มคอลัมน์สุดท้าย ไม่ให้มันกางเป็นหน้ากระดานยาวเกินไป */




  /* 3. จัดการฝั่งซ้าย (Dropdown เลือกจำนวนหน้า) */
  .dataTables_length {
      display: block !important;
      text-align: left !important;
      float: none !important; /* ล้างค่า Float ตั้งต้น */
  }
  .dataTables_length label {
      display: inline-flex !important;
      align-items: center !important;
      white-space: nowrap !important;
      font-weight: bold;
      color: #495057;
      margin: 0 !important;
  }
  .dataTables_length select {
      width: 75px !important;
      height: 31px !important;
      margin: 0 8px !important;
      padding: 2px 6px !important;
      font-size: 0.875rem;
      border-radius: 0.25rem;
      border: 1px solid #ced4da;
  }

  /* 4. จัดการฝั่งขวา (ช่องค้นหาบาร์โค้ด) */
  .dataTables_filter {
      display: block !important;
      text-align: right !important;
      float: none !important; /* ล้างค่า Float ตั้งต้น */
      margin: 0 !important; /* ดึงมาร์จินออกป้องกันมันดีดตัวสไลด์ลง */
  }
  .dataTables_filter label {
      display: inline-flex !important;
      align-items: center !important;
      white-space: nowrap !important;
      font-weight: bold;
      color: #495057;
      margin: 0 !important;
  }
  .dataTables_filter input {
      width: 250px !important;
      height: 31px !important;
      margin-left: 8px !important;
      padding: 4px 8px !important;
      font-size: 0.875rem;
      border-radius: 0.25rem;
      border: 1px solid #ced4da;
  }
  .dataTables_filter input:focus {
      border-color: #80bdff;
      outline: 0;
      box-shadow: 0 0 0 0.2rem rgba(0,123,255,.25);
  }
</style>

<div class="content-wrapper">
  <section class="content-header">
    <div class="container-fluid">
      <div class="row mb-2">
        <div class="col-sm-6">
          <h1>ระบบจัดการคิวงาน</h1>
        </div>
      </div>
    </div>
  </section>

  <section class="content">
    <div class="container-fluid">
      
        <div class="card">
        <div class="card-header bg-navy">
            <h3 class="card-title font-weight-bold">📋 ระบบจัดการคิวงานสั่งตัดและตั้งค่าใบมีด</h3>
            <div class="card-tools">
            <span id="socketStatus" class="badge bg-warning text-dark">🟡 กำลังเตรียมเชื่อมต่อ...</span>
            </div>
        </div>
        <div class="card-body p-2" style="overflow-x: auto;">
            <table id="queueTable" class="table table-bordered table-hover text-nowrap text-center align-middle">
            <thead class="bg-light">
                <tr>
                <th rowspan="2" class="align-middle">ลำดับ</th>
                <th rowspan="2" class="align-middle">เลขที่ใบสั่งผลิต</th>
                <th rowspan="2" class="align-middle">ITEM</th>
                <th rowspan="2" class="align-middle">Grade</th>
                <th rowspan="2" class="align-middle">Set</th>
                <th colspan="4" class="text-center bg-gray-light">ตั้งค่าใบมีด</th>
                <th colspan="4" class="text-center bg-gray-light">Size นิ้ว</th>
                <th rowspan="2" class="align-middle">วันที่เสร็จ</th>
                <th rowspan="2" class="align-middle">เวลา</th>
                <th rowspan="2" class="align-middle">ลูก</th>
                <th rowspan="2" class="align-middle">Set</th>
                <th rowspan="2" class="align-middle">สถานะ</th>
                <th rowspan="2" class="align-middle bg-navy">ปุ่มกดจัดการคิวงาน</th>
                </tr>
                <tr>
                <th>1</th><th>2</th><th>3</th><th>4</th>
                <th>1</th><th>2</th><th>3</th><th>4</th>
                </tr>
            </thead>
            <tbody>
            </tbody>
            </table>
        </div>
        </div>

    </div>
  </section>
</div>

<%- include('../partials/footer') %>

<script src="/plugins/datatables/jquery.dataTables.min.js"></script>
<script src="/plugins/datatables-bs4/js/dataTables.bootstrap4.min.js"></script>
<script src="/socket.io/socket.io.js"></script>
<script>
  // ประกาศตัวแปรจองตารางไว้เป็น Global ด้านบนสุดเพื่อให้ฟังก์ชันอื่นเรียกใช้ได้ค่ะ
  let queueTable;
  const socket = io('/socket/wait-cut'); // เปิดสาย Socket ค้างไว้ตัวเดียวในหน้าเว็บ

  $(function () {
    // 1. ดึงข้อมูลที่หลังบ้านพ่นมาผ่าน EJS
    const serverData = <%- JSON.stringify(orders) %>;

    // 2. สั่งให้ DataTables ทำงานรอบเดียวตอนเปิดหน้าเว็บสำเร็จ
    queueTable = $('#queueTable').DataTable({
        "paging": true,
        "pageLength": 25,
        "searching": true,
        "ordering": false,
        "data": serverData,
        "columns": [
            { "data": "number" },                                    // 1. ลำดับคิว (ย้ายมาโชว์ช่องแรกสุดตามการอัปเกรด)
            { "data": "orderNo" },                                       // 2. เลขที่ใบสั่งผลิต
            { "data": "orderItem" },                                      // 3. ITEM (เอารหัสม้วนย่อยมาวางแทนชั่วคราว)
            { "data": "grade1" },                                      // 4. Grade (เอารหัสม้วนย่อยมาวางแทนชั่วคราว)
            { "data": null , "defaultContent": "-" },                                    // 5. Set

            // 🔒 ช่องตั้งค่าใบมีด 1-4 และ Size นิ้ว 1-4 (ไม่มีข้อมูลจริงในเบสเทส สั่งให้ขึ้นช่องว่างเคลนๆ ตามคำสั่งกัปตัน)
            { "data": "blad1", "defaultContent": "" },                    // 6. ใบมีด 1
            { "data": "blad2", "defaultContent": "" },                    // 7. ใบมีด 2
            { "data": "blad3", "defaultContent": "" },                    // 8. ใบมีด 3
            { "data": "blad4", "defaultContent": "" },                    // 9. ใบมีด 4
            { "data": "size1", "defaultContent": "" },                    // 10. Size 1
            { "data": "size2", "defaultContent": "" },                    // 11. Size 2
            { "data": "size3", "defaultContent": "" },                    // 12. Size 3
            { "data": "size4", "defaultContent": "" },                    // 13. Size 4
            { "data": "finishDate", "defaultContent": "" },                    // 14. วันที่เสร็จ (เว้นว่างรอเบสจริง)
            { "data": "finishTime", "defaultContent": "" },     // 15. เวลา (เว้นว่างรอเบสจริง)
            { "data": "diameter", "defaultContent": "" },                              // 16. ลูก (จำนวนลำดับม้วนย่อยในเซต)
            { "data": null, "defaultContent": "" },         // 17. Set (เอาน้ำหนักเป้าหมายมาแปะดูต่างหน้า)
            { 
              "data": "status",
              "render": function(data) {
                  let badgeClass = 'bg-warning text-dark';
                  if (data === 'HOLD') badgeClass = 'bg-secondary';
                  if (data === 'เสร็จสิ้น') badgeClass = 'bg-success';
                  return `<span class="badge ${badgeClass}">${data}</span>`;
              }
            },
            {
                "data": null,
                "render": function(data, type, row) {
                    if (row.status === 'เสร็จสิ้น') {
                      return `<button class="btn btn-sm btn-outline-secondary m-1" disabled>สิ้นสุดกระบวนการ</button>`;
                    }
                    return `
                    <div class="d-flex flex-wrap justify-content-center">
                        <button class="btn btn-sm btn-primary font-weight-bold m-1" onclick="actionCut(${row.id})">สั่งตัด</button>
                        <button class="btn btn-sm btn-secondary font-weight-bold text-white m-1" onclick="actionHold(${row.id})">HOLD</button>
                        <button class="btn btn-sm btn-light border font-weight-bold m-1" onclick="actionUnhold(${row.id})">ปลด HOLD</button>
                        <button class="btn btn-sm btn-success font-weight-bold m-1" onclick="actionSuccess(${row.id})">เสร็จสิ้น</button>
                        <button class="btn btn-sm btn-warning font-weight-bold m-1" onclick="actionReset(${row.id})">Reset</button>
                        <button class="btn btn-sm btn-default border font-weight-bold m-1" onclick="moveUp(${row.id},${row.que})"><i class="fas fa-chevron-up"></i> ขึ้น</button>
                        <button class="btn btn-sm btn-default border font-weight-bold m-1" onclick="moveDown(${row.id},${row.que})"><i class="fas fa-chevron-down"></i> ลง</button>
                    </div>
                    `;
                }
            }
        ],
        "createdRow": function(row, data, dataIndex) {
        $(row).attr('data-id', data.id);
        $(row).attr('data-queue', data.que); 
    }
    });

    // 🔌 ดักฟังสถานะไฟสีเขียว/แดง บนหัวตาราง
    socket.on('connect', function() {
      $('#socketStatus').removeClass('bg-warning bg-danger').addClass('bg-success text-white').text('🟢 เชื่อมต่อเรียลไทม์ปกติ');
    });

    socket.on('disconnect', function() {
      $('#socketStatus').removeClass('bg-success bg-warning').addClass('bg-danger text-white').text('🔴 การเชื่อมต่อหลุด (ข้อมูลอาจไม่อัปเดต)');
    });


    socket.on('update_queue_table', function(res) {
    console.log("📥 [RenderMoveQue] อัปเดตข้อมูลยกล็อตด้วยวิธีล้างและแอดใหม่ (ล็อกสถานะ)");
    if (!res || !res.success || !res.data) return;

    const newQueueArray = res.data;

    // 1. ล้างข้อมูลเก่าออกจากหน่วยความจำของตารางชั่วคราว
    queueTable.clear();

    // 2. เติมข้อมูล Array ชุดใหม่ที่เรียงลำดับมาจากหลังบ้านอย่างถูกต้องเข้าไป (1, 2, 3...)
    queueTable.rows.add(newQueueArray);

    // 3. 🚀 สั่งวาดตารางใหม่ทันที 
    // ใส่ false เพื่อบังคับล็อกหน้าเพจ (Pagination) และคงคำค้นหา (Search Filter) ของพนักงานไว้เหมือนเดิมเป๊ะ!
    queueTable.draw(false);
    
    console.log("✨ วาดโครงสร้างตารางใหม่ยกล็อตสำเร็จ แถวเรียง 1 2 3 ตรงตามฐานข้อมูล 100%!");
});


    $('[data-widget="pushmenu"]').on('click', function() {
        console.log("💥 ปุ่มสามขีดโดนกดแล้ว กำลังรอระเบิดแอนิเมชัน Sidebar...");

        // ⏳ หน่วงเวลา 350ms รอให้หน้าจอขยับเปลี่ยนขนาดเสร็จสิ้นก่อน
        setTimeout(function() {
            // ตรวจเช็กว่าตัวแปรตารางพร้อมรบไหม ถ้าพร้อมสั่งลุยยืดขนาดทันที!
            if (queueTable) {
                console.log("🚀 ลั่นไกตรงผ่านตัวแปร queueTable ให้คำนวณสัดส่วนใหม่!");
                queueTable.columns.adjust().draw(false);
            }
        }, 350);
    });


  });

  
    function moveUp(myId, myQueue) {
        // 1. ดึงข้อมูลทั้งหมดที่จัดเรียงอยู่ ณ ปัจจุบันออกมาจาก DataTable เป็น Array ดิบ
        // (ใช้คำสั่ง .rows({ order: 'applied' }).data() เพื่อให้ได้ลำดับตามที่ตาเห็นจริงในระบบ)
        const allData = queueTable.rows({ order: 'applied' }).data().toArray();

        // 2. ค้นหาดัชนี (Index) ของตัวเราเองใน Array นั้น
        const myIndex = allData.findIndex(row => Number(row.id) === Number(myId));

        // 3. 🚨 เช็กดักกรณีเป็นตัวแรกสุดของตารางทั้งหมดจริง ๆ (คิวที่ 1 ของหน้า 1)
        if (myIndex === 0) {
            alert('งานนี้อยู่บนสุดของรายการทั้งหมดแล้ว ไม่สามารถขยับขึ้นได้อีก!');
            return;
        }

        // 4. 🎯 ทีเด็ดอยู่ตรงนี้: หาคู่กรณีตัวบนโดยถอย Index ไป 1 ตำแหน่ง 
        // ต่อให้ตัวบนจะอยู่อีกหน้าเพจหนึ่ง มันก็จะเจอตัวอย่างแม่นยำ 100% เพราะค้นจาก Array ข้อมูล
        const upperRowData = allData[myIndex - 1];

        const aboveId = upperRowData.id;
        const aboveQueue = upperRowData.number; // หรือฟิลด์คิวที่กัปตันใช้เก็บเลขคิว

        console.log(`🔼 [Client Request - Array Mode] สลับข้ามหน้า: ID ${myId} (คิว ${myQueue}) -> แทนที่แถวบน ID ${aboveId} (คิว ${aboveQueue})`);

        // 5. ยิงข้อมูลคู่กรณีที่แท้จริงส่งไปหลังบ้านผ่านท่อ Socket ตัวเดิม
        socket.emit('swapQueue', {
            orderId: myId,
            current_que: myQueue,
            aboveOrderId: aboveId,
            above_que: aboveQueue
        });
    }

    function moveDown(myId, myQueue) {
        const allData = queueTable.rows({ order: 'applied' }).data().toArray();
        const myIndex = allData.findIndex(row => Number(row.id) === Number(myId));

        // ดักกรณีอยู่แถวสุดท้ายของรายการทั้งหมด (หน้าสุดท้าย แถวสุดท้าย)
        if (myIndex === allData.length - 1) {
            alert('งานนี้อยู่ล่างสุดของรายการทั้งหมดแล้ว ไม่สามารถขยับลงได้อีก!');
            return;
        }

        // หาคู่กรณีตัวล่างโดยบวก Index ไป 1 ตำแหน่ง (ทะลุหน้าเพจได้สบายมาก)
        const lowerRowData = allData[myIndex + 1];

        const belowId = lowerRowData.id;
        const belowQueue = lowerRowData.number;

        console.log(`🔽 [Client Request - Array Mode] สลับข้ามหน้าลง: ID ${myId} (คิว ${myQueue}) -> แทนที่แถวล่าง ID ${belowId} (คิว ${belowQueue})`);

        // ส่งไปหลังบ้าน (เรียกใช้ลอจิกคู่กรณีเดียวกับขาขึ้น แต่อลับฝั่งตัวแปรส่ง)
        socket.emit('swapQueue', {
            orderId: myId,
            current_que: myQueue,
            aboveOrderId: belowId,
            above_que: belowQueue
        });
    }
    

  // เผื่อฟังก์ชันปุ่มสถานะอื่นๆ รอไว้ให้ไม่เกิด error ตอนพนักงานกดเล่นค่ะ
  function actionCut(id) { console.log('สั่งตัด:', id); }
  function actionHold(id) { console.log('HOLD:', id); }
  function actionUnhold(id) { console.log('ปลด HOLD:', id); }
  function actionSuccess(id) { console.log('เสร็จสิ้น:', id); }
  function actionReset(id) { console.log('Reset:', id); }
</script>
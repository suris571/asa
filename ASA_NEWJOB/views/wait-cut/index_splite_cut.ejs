<%- include('../partials/header') %>
<%- include('../partials/sidebar') %>

<style>
  /* 1. บังคับแผงควบคุมชั้นนอกสุดให้เรียงตัวเป็นแนวขวางบรรทัดเดียว ไม่ให้หักหล่น */
  .dataTables_wrapper .row:first-child {
      display: flex !important;
      flex-direction: row !important;
      flex-wrap: nowrap !important; 
      /* 🔒 ล็อกห้ามขึ้นบรรทัดใหม่เด็ดขาด */
      justify-content: space-between !important;
      align-items: center !important;
      width: 100% !important;
      margin: 0 0 12px 0 !important;
      padding: 0 !important;
  }

  /* 2. ดักล้างค่าความกว้างดีฟอลต์ของระบบเก่าที่แอบบีบพื้นที่ */
  .dataTables_wrapper .row:first-child > div {
      flex: 0 0 auto !important;
      max-width: auto !important;
      width: auto !important;
      padding: 0 !important;
  }


  #queueTable {
    width: 100% !important;
    min-width: 1200px !important; /* 🔥 ไม้ตาย: ล็อกฐานความกว้างขั้นต่ำไว้ ถ้าจอเล็กลงกว่านี้ค่อยขึ้น Scrollbar จะไม่มีวันบี้! */
    table-layout: auto !important;
}

/* 🔒 จัดระเบียบปุ่มคอลัมน์สุดท้าย ไม่ให้มันกางเป็นหน้ากระดานยาวเกินไป */




  /* 3. จัดการฝั่งซ้าย (Dropdown เลือกจำนวนหน้า) */
  .dataTables_length {
      display: block !important;
      text-align: left !important;
      float: none !important; /* ล้างค่า Float ตั้งต้น */
  }
  .dataTables_length label {
      display: inline-flex !important;
      align-items: center !important;
      white-space: nowrap !important;
      font-weight: bold;
      color: #495057;
      margin: 0 !important;
  }
  .dataTables_length select {
      width: 75px !important;
      height: 31px !important;
      margin: 0 8px !important;
      padding: 2px 6px !important;
      font-size: 0.875rem;
      border-radius: 0.25rem;
      border: 1px solid #ced4da;
  }

  /* 4. จัดการฝั่งขวา (ช่องค้นหาบาร์โค้ด) */
  .dataTables_filter {
      display: block !important;
      text-align: right !important;
      float: none !important; /* ล้างค่า Float ตั้งต้น */
      margin: 0 !important; /* ดึงมาร์จินออกป้องกันมันดีดตัวสไลด์ลง */
  }
  .dataTables_filter label {
      display: inline-flex !important;
      align-items: center !important;
      white-space: nowrap !important;
      font-weight: bold;
      color: #495057;
      margin: 0 !important;
  }
  .dataTables_filter input {
      width: 250px !important;
      height: 31px !important;
      margin-left: 8px !important;
      padding: 4px 8px !important;
      font-size: 0.875rem;
      border-radius: 0.25rem;
      border: 1px solid #ced4da;
  }
  .dataTables_filter input:focus {
      border-color: #80bdff;
      outline: 0;
      box-shadow: 0 0 0 0.2rem rgba(0,123,255,.25);
  }

  #queueTable td:last-child {
        white-space: nowrap !important;
        width: 1% !important; /* ไม้ตาย: บังคับให้ขยายตามขนาด Content จริงข้างใน */
    }

  .custom-filter-container {
      display: flex;
      flex-wrap: wrap;
      gap: 15px;
      margin-bottom: 15px;
      padding: 12px;
      background-color: #f8f9fa;
      border: 1px solid #dee2e6;
      border-radius: 0.25rem;
      align-items: center;
  }
  .custom-filter-item {
      display: flex;
      align-items: center;
      gap: 8px;
  }
  .custom-filter-item label {
      margin: 0;
      font-weight: bold;
      color: #495057;
      white-space: nowrap;
      font-size: 0.875rem;
  }
  .custom-filter-item input, .custom-filter-item select {
      height: 31px;
      padding: 4px 8px;
      font-size: 0.875rem;
      border-radius: 0.25rem;
      border: 1px solid #ced4da;
  }
    .custom-filter-item input.date-picker {
        width: 150px;
    }
    .custom-filter-item input[type="text"], .custom-filter-item select {
        width: 180px;
    }
    .custom-filter-item input:focus, .custom-filter-item select:focus {
        border-color: #80bdff;
        outline: 0;
    }
  




  .loading-overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.4); /* ม่านดำโปร่งแสง 40% */
    z-index: 9999; /* อยู่เหนือทุกสิ่งบนหน้าจอ */
    display: flex;
    justify-content: center;
    align-items: center;
    flex-direction: column;
}
.spinner-box {
    background: white;
    padding: 25px 40px;
    border-radius: 8px;
    box-shadow: 0 4px 15px rgba(0,0,0,0.2);
    text-align: center;
}
</style>

<div id="pageLoader" class="loading-overlay" style="display: none;">
    <div class="spinner-box">
        <div class="spinner-border text-primary mb-3" role="status" style="width: 3rem; height: 3rem;"></div>
        <h5 class="font-weight-bold mb-0 text-dark">⏳ กำลังทำรายการ...</h5>
        <small class="text-muted">กรุณารอสักครู่ ระบบกำลังดำเนินการ...</small>
    </div>
</div>

<div class="content-wrapper">
  <section class="content-header">
    <div class="container-fluid">
      <div class="row mb-2">
        <div class="col-sm-6">
          <h1>ระบบจัดการคิวงาน</h1>
        </div>
      </div>
    </div>
  </section>

  <section class="content">
    <div class="container-fluid">
      
        <div class="card">
        <div class="card-header bg-navy">
            <h3 class="card-title font-weight-bold">📋 ระบบจัดการคิวงานสั่งตัดและตั้งค่าใบมีด</h3>
            <div class="card-tools">
            <span id="socketStatus" class="badge bg-warning text-dark">🟡 กำลังเตรียมเชื่อมต่อ...</span>
            </div>
        </div>
        <div class="card-body p-2" style="overflow-x: auto;">

            <div class="custom-filter-container">

                <!-- 3. เลขที่ใบสั่งผลิต -->
                <div class="custom-filter-item">
                    <label for="searchOrderNo">🔍 เลขที่ใบสั่งผลิต:</label>
                    <input type="text" id="searchOrderNo" placeholder="พิมพ์เลขที่ใบสั่งผลิต...">
                </div>

                <!-- ปุ่มกดสั่งการ -->
                <div class="custom-filter-item ml-auto">
                    <button type="button" class="btn btn-sm btn-primary font-weight-bold" id="btnDoQuery">
                        <i class="fas fa-search"></i> ค้นหาข้อมูล
                    </button>
                    <button type="button" class="btn btn-sm btn-default border font-weight-bold" id="btnClearQuery">
                        ล้างคำค้น
                    </button>
                </div>
            </div>

            <table id="splitSetTable" class="table table-bordered table-hover text-nowrap text-center align-middle w-100">
                <thead class="bg-light">
                    <tr>
                        <th rowspan="2" class="align-middle">เลขที่ใบสั่งผลิต</th>
                        <th rowspan="2" class="align-middle">ITEM</th>
                        <th colspan="4" class="text-center bg-gray-light">GRADE</th>
                        <th rowspan="2" class="align-middle">Set</th>
                        <th colspan="4" class="text-center bg-gray-light">ตั้งค่าใบมีด</th>
                        <th colspan="4" class="text-center bg-gray-light">Size นิ้ว</th>
                        <th rowspan="2" class="align-middle">ความยาว</th>
                        <th colspan="4" class="text-center bg-navy">ปุ่มกด</th>
                    </tr>
                    <tr>
                        <!-- grade -->
                        <th>1</th><th>2</th><th>3</th><th>4</th>
                        <!-- ตั้งค่าใบมีด -->
                        <th>1</th><th>2</th><th>3</th><th>4</th>
                        <!-- Size นิ้ว -->
                        <th>1</th><th>2</th><th>3</th><th>4</th>
                        <!-- ปุ่มกด -->
                        <th class="bg-light text-dark">เสร็จสิ้น</th>
                        <th class="bg-light text-dark">HOLD</th>
                        <th class="bg-light text-dark">ปลด HOLD</th>
                        <th class="bg-light text-dark">Reset</th>
                    </tr>
                </thead>
                <tbody>
                    
                </tbody>
            </table>
        </div>
        </div>

    </div>
  </section>
</div>

<%- include('../partials/footer') %>

<script src="/plugins/datatables/jquery.dataTables.min.js"></script>
<script src="/plugins/datatables-bs4/js/dataTables.bootstrap4.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/moment@2.29.4/moment.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/daterangepicker/daterangepicker.min.js"></script>
<link rel="stylesheet" type="text/css" href="https://cdn.jsdelivr.net/npm/daterangepicker/daterangepicker.css" />
<script src="/socket.io/socket.io.js"></script>

<script>
  // 1. ประกาศตัวแปรและเปิดสายสัญญาณชั้นนอกสุดตามหลักสากล
  let queueTable;
  let updateTimeout = null;
    const userProductionLineId = "<%= data.pm_select_ID ? data.pm_select_ID : '' %>";
    const socket = io('/socket/wait-cut/split-cut-set', {
        query: { 
            productionLineId: userProductionLineId 
        }
    }); 
   

  // 🔒 ไม้ตายล้างท่อ: เคลียร์ Listener ตกค้างเก่าก่อนผูกใหม่ ป้องกันการยิงเบิ้ลในความจำ (Memory Leak)
  socket.off('connect');
  socket.off('disconnect');
  socket.off('update_queue_table');
  socket.off('queue_structure_changed');

  $(function () {
    // 2. ตั้งค่าการควบคุม DateRangePicker ให้ล็อกฟอร์แมต ค.ศ.
    $('.date-picker').daterangepicker({
        singleDatePicker: true,
        showDropdowns: true,
        autoUpdateInput: false,
        autoApply: false, // เปิดแถบปุ่มไว้เพื่อให้มีปุ่ม "ล้างค่า"
        locale: {
            format: 'YYYY-MM-DD',
            cancelLabel: 'ล้างค่า', 
            daysOfWeek: ['อา','จ','อ','พ','พฤ','ศ','ส'],
            monthNames: ['มกราคม','กุมภาพันธ์','มีนาคม','เมษายน','พฤษภาคม','มิถุนายน','กรกฎาคม','สิงหาคม','กันยายน','ตุลาคม','พฤศจิกายน','ธันวาคม'],
            firstDay: 1
        }
    });

    $('.date-picker').on('apply.daterangepicker', function(ev, picker) {
        $(this).val(picker.startDate.format('YYYY-MM-DD'));
        $(this).data('daterangepicker').hide(); // เลือกวันปุ๊บ สั่งซ่อนหน้าต่างทันที ไม่ต้องกดปุ่มตกลง
    });

    $('.date-picker').on('cancel.daterangepicker', function(ev, picker) {
        $(this).val(''); // เคลียร์กล่องข้อความอย่างเดียวตามสั่ง ไม่ยิง Query
    });

    // 3. จัดระเบียบสายสัญญาณ Socket Listeners ให้อยู่ในจังหวะที่ DOM พร้อมใช้งานอย่างปลอดภัย
    socket.on('connect', function() {
      $('#socketStatus').removeClass('bg-warning bg-danger').addClass('bg-success text-white').text('🟢 เชื่อมต่อเรียลไทม์ปกติ');
    });

    socket.on('disconnect', function() {
      $('#socketStatus').removeClass('bg-success bg-warning').addClass('bg-danger text-white').text('🔴 การเชื่อมต่อหลุด (ข้อมูลอาจไม่อัปเดต)');
    });
    

    
    socket.on('queue_structure_changed', function(res) {
        console.log("🔔 สัญญาณเตือนภัยคิวเปลี่ยน: ทำการสั่งดาวน์โหลดข้อมูลตามฟิลเตอร์ปัจจุบันของตัวเองทันที!");
        if (res && res.success) {
            fetchFilteredQueue(); 
        }
    });

    // 4. ดึงข้อมูลชุดแรกจาก Server มาเรนเดอร์ตารางตอนเปิดหน้าเว็บ
    const serverData = <%- JSON.stringify(orders) %>;
    queueTable = $('#splitSetTable').DataTable({
        "paging": true,
        "pageLength": 25,
        "searching": true,
        "ordering": false,
        "data": serverData, 
        "columns": [
            { "data": "order_no" },
            { "data": "orderItem" },
            { "data": "grade1" },
            { "data": "grade2" },
            { "data": "grade3" },
            { "data": "grade4" },
            { 
                "data": "set",
                "render": function(data) {
                    return `<span class="font-weight-bold text-primary">${data || '-'}</span>`;
                }
            },
            { "data": "blad1", "defaultContent": "" },
            { "data": "blad2", "defaultContent": "" },
            { "data": "blad3", "defaultContent": "" },
            { "data": "blad4", "defaultContent": "" },
            { "data": "size1", "defaultContent": "" },
            { "data": "size2", "defaultContent": "" },
            { "data": "size3", "defaultContent": "" },
            { "data": "size4", "defaultContent": "" },
            { 
                "data": "lenght", // หรือ "cut_length"
                "render": function(data, type, row) {
                    const setStatus = row.status ? parseInt(row.status) : parseInt(row.cut_status_id);
                    
                    // แปลงค่าเริ่มต้นให้มีคอมมา (เช่น 1000 -> 1,000)
                    let formattedVal = '';
                    if (data !== null && data !== undefined && data !== '') {
                        formattedVal = Number(data).toLocaleString('en-US');
                    }
                    if(formattedVal === '0') {
                        formattedVal = '';
                    }
                    const isDisabled = (setStatus === 5) ? 'disabled readonly' : '';

                    return `
                        <div class="d-flex justify-content-center align-items-center">
                            <input type="text" 
                                class="form-control form-control-sm text-center font-weight-bold input-cut-length" 
                                style="max-width: 110px; border-color: #ced4da;"
                                value="${formattedVal}"
                                ${isDisabled}
                                oninput="formatNumberWithComma(this)">
                        </div>
                    `;
                }
            },
            // 🎯 คอลัมน์ปุ่ม "เสร็จสิ้น"
            {
                "data": null,
                "render": function(data, type, row) {
                    const setStatus = row.status ? parseInt(row.status) : parseInt(row.cut_status_id);

                    // 🟢 ถ้าเสร็จสิ้นแล้ว (status = 5) เปลี่ยนเป็น Badge สีเขียวเด่นๆ
                    if (setStatus === 5) {
                        return `<span class="badge badge-success btn-sm p-2 btn-block font-weight-bold" style="font-size: 90%;">✓ เสร็จสิ้น</span>`; 
                    }

                    // 🟡 สถานะอื่น (รวมถึง HOLD = 4) แสดงปุ่มเสร็จสิ้นให้กดได้
                    return `<button class="btn btn-sm btn-success font-weight-bold btn-block" 
                                onclick="actionSetSuccess(${row.split_set_id}, ${row.pl_order_id}, ${row.pl_order_detail_id})">
                                เสร็จสิ้น
                            </button>`;
                }
            },
            // 🎯 คอลัมน์ปุ่ม "HOLD"
            {
                "data": null,
                "render": function(data, type, row) {
                    const setStatus = row.status ? parseInt(row.status) : parseInt(row.cut_status_id);
                    // 🟡 ติด HOLD อยู่ (status = 4) แสดง Badge คำว่า HOLD ชัดๆ
                    if (setStatus === 4) {
                        return `<span class="badge badge-dark btn-sm p-2 btn-block font-weight-bold" style="background-color: #5a6268; font-size: 90%;">⛔ HOLD</span>`;
                    }
                    // 🟢 เสร็จสิ้นแล้ว (status = 5) จางปุ่มลงให้เห็นชัดว่ากดไม่ได้
                    if (setStatus === 5) {
                        return `<button class="btn btn-sm btn-secondary font-weight-bold btn-block" disabled style="opacity: 0.25; cursor: not-allowed;">HOLD</button>`;
                    }
                    // ⚪ สถานะปกติ
                    return `<button class="btn btn-sm btn-secondary font-weight-bold btn-block" 
                                onclick="actionSetHold(${row.split_set_id}, ${row.pl_order_id}, ${row.pl_order_detail_id})">
                                HOLD
                            </button>`;
                }
            },
            // 🎯 คอลัมน์ปุ่ม "ปลด HOLD"
            {
                "data": null,
                "render": function(data, type, row) {
                    const setStatus = row.status ? parseInt(row.status) : parseInt(row.cut_status_id);
                    // 🟡 ติด HOLD อยู่ (status = 4) เน้นปุ่ม "ปลด HOLD" เป็นสีน้ำเงินให้เห็นชัดเจน
                    if (setStatus === 4) {
                        return `<button class="btn btn-sm btn-primary font-weight-bold btn-block shadow-sm" 
                                    onclick="actionSetUnhold(${row.split_set_id}, ${row.pl_order_id}, ${row.pl_order_detail_id})">
                                    🔓 ปลด HOLD
                                </button>`;
                    }
                    // 🔒 สถานะอื่น จางปุ่มลงให้รู้ว่าใช้ไม่ได้
                    return `<button class="btn btn-sm btn-light border font-weight-bold btn-block text-muted" disabled style="opacity: 0.25; cursor: not-allowed;">
                                ปลด HOLD
                            </button>`;
                }
            },
            // 🎯 คอลัมน์ปุ่ม "Reset"
            {
                "data": null,
                "render": function(data, type, row) {
                    const setStatus = row.status ? parseInt(row.status) : parseInt(row.cut_status_id);

                    // 🟢 1. สถานะต้องเป็น 5 (เสร็จสิ้น) เท่านั้น ถึงจะกด Reset ได้
                    if (setStatus === 5) {
                        return `<button class="btn btn-sm btn-warning text-white font-weight-bold btn-block" 
                                    onclick="actionSetReset(${row.split_set_id}, ${row.pl_order_id}, ${row.pl_order_detail_id})">
                                    Reset
                                </button>`;
                    }

                    // 🔒 2. ถ้าสถานะไม่ใช่ 5 (ยังไม่เสร็จ) ให้ Disable ปุ่ม Reset ไว้
                    return `<button class="btn btn-sm btn-warning text-white font-weight-bold btn-block" disabled style="opacity: 0.35; cursor: not-allowed;">
                                Reset
                            </button>`;
                }
            }
        ],
        // 🎨 จุดเด่นที่สุด: เพิ่มการไฮไลต์สีพื้นหลังทั้งแถว (Row Style) ตามสถานะ
        "createdRow": function(row, data, dataIndex) {
            $(row).attr('data-split-id', data.splitSetId);
            const setStatus = data.status ? parseInt(data.status) : parseInt(data.cut_status_id);
            if (setStatus === 5) {
                // 🟢 แถวที่เสร็จสิ้น: ปรับพื้นหลังเป็นสีเขียวอ่อน นุ่มตา
                $(row).css('background-color', '#e6f4ea'); 
            } else if (setStatus === 4) {
                // 🟡 แถวที่ติด HOLD: ปรับพื้นหลังเป็นสีส้ม/เทาเตือนสายตา
                $(row).css('background-color', '#fff3cd'); 
            }
        }
    });

    socket.on('update_queue_table', function(res) {
        hideLoader();
        if (!res || !res.success || !res.data) return;
        
        if (queueTable) {
           queueTable.clear().rows.add(res.data).draw(false);
        }
    });

    // ปรับสัดส่วนตารางเมื่อกดปุ่มย่อ/ขยายแถบเมนูด้านซ้าย
    $('[data-widget="pushmenu"]').on('click', function() {
        setTimeout(function() {
            if (queueTable) {
                queueTable.columns.adjust().draw(false);
            }
        }, 350);
    });

    // ผูกคำสั่งกับปุ่มกดค้นหาหลักของระบบ
    $('#btnDoQuery').on('click', function() {
        fetchFilteredQueue();
    });

    // ผูกคำสั่งกับปุ่มล้างคำค้น
    $('#btnClearQuery').on('click', function() {
        $('#filterMinDate').val('');
        $('#filterMaxDate').val('');
        $('#searchStatus').val('');
        $('#searchOrderNo').val('');
        fetchFilteredQueue(); 
    });
  });

    function formatNumberWithComma(input) {
        // 1. ลบทุกตัวอักษรที่ไม่ใช่ตัวเลขออกก่อน
        let rawValue = input.value.replace(/[^0-9]/g, '');
        
        // 2. แปลงเป็นรูปแบบมีคอมมา
        if (rawValue) {
            input.value = Number(rawValue).toLocaleString('en-US');
        } else {
            input.value = '';
        }
    }
  
  function fetchFilteredQueue() {
      const filterParams = {
          orderNo: $('#searchOrderNo').val() ? $('#searchOrderNo').val().trim() : null
      };
      console.log("🚀 [Client Request] ยิงเงื่อนไขไป Query บนหลังบ้าน:", filterParams);
      socket.emit('get_filtered_queue', filterParams);
  }

    // เผื่อฟังก์ชันปุ่มสถานะอื่นๆ รอไว้ไม่ให้เกิดข้อผิดพลาด
    function actionSetSuccess(split_set_id, pl_order_id, pl_order_detail_id) { 
        // 🎯 1. ดึง Textbox แบบหาจากปุ่มบรรทัดเดียวกันเลย (ชัวร์ที่สุด 100% ไม่ต้องลุ้น data-id)
        const btn = $(event.target).closest('button');
        const row = btn.closest('tr');
        const lengthInput = row.find('input.input-cut-length');

        const lengthValue = lengthInput.val() ? lengthInput.val().trim() : '';
        const cleanLength = Number(lengthValue.replace(/,/g, ''));

        // 🛑 2. Validation: ถ้ายังไม่กรอก หรือเป็น 0
        if (!lengthValue || isNaN(cleanLength) || cleanLength <= 0) {
            
            // 🔴 เติม Class สไตล์ Bootstrap และใส่ Border แดงแบบบังคับ !important
            lengthInput.addClass('is-invalid').css({
                'border': '2px solid #dc3545 !important',
                'background-color': '#f8d7da'
            });
            
            lengthInput.focus();

            alert("❌ กรุณาระบุ 'ความยาว' ให้ถูกต้องก่อนกดเสร็จสิ้น!");
            return; 
        }

        // 🟢 ถ้าผ่านแล้ว เคลียร์สีแดงออก
        lengthInput.removeClass('is-invalid').css({
            'border': '',
            'background-color': ''
        });

        // 3. ล็อกจอขึ้น Loading ทันทีป้องกันการกดรัว
        showLoader(); 

        console.log(`🚀 [Client REST Request] เสร็จสิ้นสร้างข้อมูลรับน้ำหนัก split_set_id ID: ${split_set_id}, ความยาว: ${cleanLength}`);

        // 4. ยิง HTTP POST API ไปหลังบ้าน (แนบ cutLength ไปด้วย)
        fetch('/wait-cut/start-weighing', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
                split_set_id: split_set_id,
                pl_order_id: pl_order_id,
                pl_order_detail_id: pl_order_detail_id,
                cut_length: cleanLength // 👈 แนบความยาวที่ถอดคอมมาออกแล้วส่งไปพร้อมกันได้เลย
            })
        })
        .then(response => response.json())
        .then(res => {
            if (res.success) {
                console.log('✅ หลังบ้านบันทึก record ชั่งน้ำหนัก รอรับสัญญาณกระจายเสียงจากท่อ Socket...');
            } else {
                hideLoader();
                alert(`❌ เกิดข้อผิดพลาดจากระบบ: ${res.message || 'ไม่สามารถบันทึกได้'}`);
            }
        })
        .catch(error => {
            hideLoader();
            console.error("❌ API Error:", error);
            alert("❌ ไม่สามารถเชื่อมต่อกับเซิร์ฟเวอร์เพื่อสั่งตัดงานได้ กรุณาลองใหม่อีกครั้ง");
        });
    }


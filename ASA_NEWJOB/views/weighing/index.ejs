<%- include('../partials/header') %>
<%- include('../partials/sidebar') %>
<style>
  /* 1. บังคับแผงควบคุมชั้นนอกสุดให้เรียงตัวเป็นแนวขวางบรรทัดเดียว ไม่ให้หักหล่น */
  .dataTables_wrapper .row:first-child {
      display: flex !important;
      flex-direction: row !important;
      flex-wrap: nowrap !important; /* 🔒 ล็อกห้ามขึ้นบรรทัดใหม่เด็ดขาด */
      justify-content: space-between !important;
      align-items: center !important;
      width: 100% !important;
      margin: 0 0 12px 0 !important;
      padding: 0 !important;
  }

  /* 2. ดักล้างค่าความกว้างดีฟอลต์ของระบบเก่าที่แอบบีบพื้นที่ */
  .dataTables_wrapper .row:first-child > div {
      flex: 0 0 auto !important;
      max-width: auto !important;
      width: auto !important;
      padding: 0 !important;
  }

  /* 3. จัดการฝั่งซ้าย (Dropdown เลือกจำนวนหน้า) */
  .dataTables_length {
      display: block !important;
      text-align: left !important;
      float: none !important; /* ล้างค่า Float ตั้งต้น */
  }
  .dataTables_length label {
      display: inline-flex !important;
      align-items: center !important;
      white-space: nowrap !important;
      font-weight: bold;
      color: #495057;
      margin: 0 !important;
  }
  .dataTables_length select {
      width: 75px !important;
      height: 31px !important;
      margin: 0 8px !important;
      padding: 2px 6px !important;
      font-size: 0.875rem;
      border-radius: 0.25rem;
      border: 1px solid #ced4da;
  }

  /* 4. จัดการฝั่งขวา (ช่องค้นหาบาร์โค้ด) */
  .dataTables_filter {
      display: block !important;
      text-align: right !important;
      float: none !important; /* ล้างค่า Float ตั้งต้น */
      margin: 0 !important; /* ดึงมาร์จินออกป้องกันมันดีดตัวสไลด์ลง */
  }
  .dataTables_filter label {
      display: inline-flex !important;
      align-items: center !important;
      white-space: nowrap !important;
      font-weight: bold;
      color: #495057;
      margin: 0 !important;
  }
  .dataTables_filter input {
      width: 250px !important;
      height: 31px !important;
      margin-left: 8px !important;
      padding: 4px 8px !important;
      font-size: 0.875rem;
      border-radius: 0.25rem;
      border: 1px solid #ced4da;
  }
  .dataTables_filter input:focus {
      border-color: #80bdff;
      outline: 0;
      box-shadow: 0 0 0 0.2rem rgba(0,123,255,.25);
  }
</style>

<div class="content-wrapper">
  <section class="content-header p-2">
    <div class="container-fluid">
      <h1 class="h3 font-weight-bold">⚖️ ระบบรับน้ำหนักลูกกระดาษ (ท้ายไลน์ผลิตที่ 1)</h1>
    </div>
  </section>

  <section class="content p-2">
    <div class="container-fluid">
      
      <div class="card card-primary card-outline shadow-sm">
        <div class="card-body p-3">
          <form id="weighingForm">
            <input type="hidden" id="id" name="id" value="<%= (nextData && nextData.id) ? nextData.id : '' %>">
            <div class="row">
              <%- include('components/step1-order') %>
              <%- include('components/step2-weight') %>
              <%- include('components/step3-action') %>
            </div>
          </form>
        </div>
      </div>

      <%- include('components/order-modal') %>
      <%- include('components/history-table') %>

    </div>
  </section>
</div>

<%- include('../partials/footer') %>
<script src="/plugins/datatables/jquery.dataTables.min.js"></script>
<script src="/plugins/datatables-bs4/js/dataTables.bootstrap4.min.js"></script>
<script src="/socket.io/socket.io.js"></script>
<script>
    let weighingTable;
    let socket = io('/socket/weighing');
    let socketScale = io('http://localhost:4000');

    async function sendDataToPrint(data) {
        $.ajax({
            url: data.url, // 👈 ชี้เป้าไปที่ท่อที่เราเปิดทดสอบไว้ (พอร์ต 3000 หรือ 4000)
            method: 'POST',        // สลับร่างเป็น POST ตามสเปกงานจริง
            contentType: 'application/json',
            data: JSON.stringify(data.body), // แปลงข้อมูลเป็น JSON สตริงก่อนวิ่งผ่านสายแลน
            success: function(response) {
            },
            error: function(xhr, status, error) {
                console.error("💥 ท่อยิงพิมพ์ล่ม:", error);
            }
        });
    }

    $(function () {
        console.log("⚓️ หน้าจอชั่งน้ำหนักและชิ้นส่วนคอมโพเนนต์พร้อมรบ!");

        $('#remark').on('input', function() {
            $(this).css({
                'border-color': '',
                'background-color': '',
                'box-shadow': ''
            });
        });


        // ตัวอย่าง: ดักฟังปุ่มกดจากสเต็ป 1
        $('#orderNo').on('change', function() {  });

        // ตัวอย่าง: ดักฟังการ Submit ฟอร์มที่รวมทุกสเต็ปเข้าด้วยกัน
        // ตัวอย่าง: ดักฟังการ Submit ฟอร์มที่รวมทุกสเต็ปเข้าด้วยกัน
        $('#weighingForm').on('submit', async function(e) {
            e.preventDefault()

            const selectedStatus = $('input[name="status"]:checked').val();
            const remarkInput = $('#remark'); // ดึง Object ช่องหมายเหตุมาถือไว้
            const remarkValue = remarkInput.val().trim();
            if (selectedStatus === 'HOLD' && remarkValue === '') {
                remarkInput.css({
                    'border-color': '#dc3545',
                    'background-color': '#f8d7da',
                    'box-shadow': '0 0 0 0.2rem rgba(220, 53, 69, 0.25)'
                });
                remarkInput.focus();
                return;
            }

            remarkInput.css({
                'border-color': '',
                'background-color': '',
                'box-shadow': ''
            });

            const formData = {};
            $(this).serializeArray().forEach(item => {
                formData[item.name] = item.value;
            });
            
            try {
                let saveDB = sendDataToPrint({ url: 'http://localhost:4000/preview-label', body: formData });
                // 3. ยิงไปบันทึก Database ที่ Backend หลัก (พอร์ต 3000)
                const response = await $.ajax({
                    url: '/weighing/save',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify(formData)
                });

                if (response.success) {
                    
                    resetWeighingForm()
                    fetchFilteredQueue()
                } else {
                    console.log("❌ เกิดข้อผิดพลาด: " + response.message)
                }

            } catch (err) {
                console.error("💥 ยิงบันทึก DB ล้มเหลว:", err);
            }

            

        });

        let modalTable = $('#modalOrderTable').DataTable({
            "paging": true,
            "searching": false, // ปิดช่องเสิร์ชในป็อปอัปเพราะสโคปเฉพาะใบงานนั้นแล้ว
            "lengthChange": false,
            "info": false,
            "autoWidth": false
        });

        $('#btnFetchOrder').on('click', function() {
            const btn = $(this);
            const orderNo = $('#orderNo').val().trim();

            if (!orderNo) {
                alert('❌ กรุณาระบุเลขใบสั่งผลิตก่อนกดดึงคิวค่ะกัปตัน!');
                return false;
            }

            // 💾 1. เก็บสเปกหน้าตาและข้อความดั้งเดิมของปุ่มเอาไว้ในตัวแปรอย่างปลอดภัย
            const originalHtml = btn.html();

            // 🔒 2. ล็อกปุ่ม และเปลี่ยนข้อความเป็น Spinner หมุนๆ
            btn.prop('disabled', true);
            btn.html('<i class="fas fa-spinner fa-spin"></i> กำลังดึงข้อมูล...');

            console.log(`📡 [AJAX]: กำลังวิ่งไปดึงลูกม้วนย่อยของใบงาน: ${orderNo}`);

            $.ajax({
                url: `/weighing/api/fetch-sub-rolls?order_no=${encodeURIComponent(orderNo)}`,
                method: 'GET',
                dataType: 'json',
                success: function(response) {
                    modalTable.clear();

                    if (response.success && response.data.length > 0) {
                        response.data.forEach(function(row) {
                            modalTable.row.add([
                                `<button type="button" class="btn btn-primary btn-xs font-weight-bold btn-select-order" 
                                    data-roll="${row.roll_no}" data-rell="${row.rell_no}" data-order="${row.order_no}" 
                                    data-grade="${row.grade}" data-version="${row.version}" data-size="${row.size}" data-diameter="${row.diameter}">เลือก</button>`,
                                row.order_no,
                                row.rell_no,
                                row.grade,
                                row.version,
                                row.size,
                                `<span class="badge badge-warning">${row.status || 'รอชั่งน้ำหนัก'}</span>`
                            ]);
                        });
                        modalTable.draw();

                        // เปิด Popup Modal
                        $('#orderQueueModal').modal('show');
                    } else {
                        alert(`⚠️ ไม่พบข้อมูลลูกม้วนย่อยภายใต้ใบสั่งผลิตเลขที่: ${orderNo}`);
                    }
                },
                error: function(xhr, status, error) {
                    console.error("ยิง API พัง:", error);
                    alert("❌ เกิดข้อผิดพลาดทางเทคนิค ไม่สามารถดึงข้อมูลได้");
                },
                complete: function() {
                    // 🔓 3. คืนค่าอิสระ: สั่งเอา HTML ดั้งเดิมที่จำไว้ในแรมเทคืนกลับไปที่ปุ่มทันที
                    btn.prop('disabled', false);
                    btn.html(originalHtml);
                }
            });
        });


        $('#modalOrderTable').on('click', '.btn-select-order', function() {
            $('#orderNo').val($(this).data('order'));
            $('#formRollNo').val($(this).data('roll'));
            $('#grade').val($(this).data('grade'));
            $('#version').val($(this).data('version'));
            $('#size').val($(this).data('size'));
            $('#diameter').val($(this).data('diameter') || '-');

            // ปิดหน้าต่าง Popup
            $('#orderQueueModal').modal('hide');
        });

        // 📊 ชุบชีวิตตารางประวัติให้เป็น DataTables
        weighingTable = $('#weighingHistoryTable').DataTable({
            "paging": true,          // เปิดใช้งานระบบแบ่งหน้า (10, 25, 50 แถว)
            "lengthChange": true,    // อนุญาตให้พนักงานเลือกจำนวนแถวที่จะโชว์ได้
            "searching": true,       // เปิดช่องเสิร์ชด้านบนขวา (ตรงตามรูปภาพระบบเดิมเป๊ะ!)
            "ordering": true,        // เปิดระบบกดหัวคอลัมน์เพื่อเรียงลำดับสูง-ต่ำ
            "info": true,            // แสดงข้อความ "รายการที่ 1 ถึง X จากทั้งหมด Y รายการ"
            "autoWidth": false,      // ปิดออโต้วิดท์เพื่อให้คอลัมน์ขยายตามสเปกจอ
            "responsive": true,      // รองรับกรณีเปิดบนหน้าจอขนาดเล็ก
            "language": {
                "search": "🔍 ค้นหาข้อมูลที่บันทึกแล้ว (Roll No):", // ล็อกข้อความป้ายเสิร์ชตามแบบเดิม
                "lengthMenu": "แสดง _MENU_ รายการต่อหน้า",
                "zeroRecords": "❌ ไม่พบข้อมูลประวัติการชั่งน้ำหนักในกะนี้",
                "info": "แสดงหน้า _PAGE_ จากทั้งหมด _PAGES_ หน้า",
                "infoEmpty": "ไม่มีข้อมูลแสดง",
                "paginate": {
                    "previous": "ก่อนหน้า",
                    "next": "ถัดไป"
                }
            },
            // 🛠️ ล็อกไม่ให้ระบบแอบเอาคอลัมน์สุดท้าย (พิมพ์บาร์โค้ด) มาจัดเรียงลำดับเวลาพนักงานกดหัวตาราง
            "columnDefs": [
                { "orderable": false, "targets": 7 } 
            ]
        });

        
        socket.on('queue_updated', function(response) {
            console.log("⚡ ได้รับข้อมูลคิวถัดไปจาก Socket:", response);
            if (response && response.data && $('#id').val() != response.data.id) {
                // 🎯 มีคิวถัดไป ➔ นำข้อมูลจาก Socket ยัดใส่ Input ทันที (0 HTTP Request)
                const nextData = response.data;
                $('#id').val(nextData.id);
                $('#createdAt').val(nextData.createdAt);
                $('#reelno').val(nextData.reel_no);
                $('#grade').val(nextData.gradeName);
                $('#size').val(nextData.sizeName);
                $('#model').val(nextData.model);
                $('#diameter').val(nextData.diameter);
                
                // ล้างช่องกรอกรอชั่งลูกใหม่
                $('#remark').val('');
                
                // คืนค่า CSS ให้ช่อง Remark (กรณีโดนกรอบแดงค้างไว้)
                $('#remark').css({ 'border-color': '', 'background-color': '', 'box-shadow': '' });

            } else {
                // 🛑 ไม่มีคิวเหลือในระบบแล้ว
                if(response && response.data && $('#id').val() == response.data.id){
                    return
                }
                resetWeighingForm()
                // alert('🎉 รายการรอชั่งน้ำหนักไม่มีในรายการแล้ว!');
            }
        });
        
        socketScale.on('connect', function() {
            console.log('🟢 ท่อหน้าเว็บจิ้มสตรีมน้ำหนักจาก Agent สำเร็จ!');
        });

        // 🧠 หัวใจสำคัญ: ดักรับเหตการณ์น้ำหนักวิ่งไหลมาจากเครื่องชั่งผ่านสาย Socket
        socketScale.on('weight_stream', function(data) {
            // data ประกอบด้วย { weight: ทศนิยม, stable: boolean }
            // console.log(`📥 ค่าน้ำหนักสตรีมโชว์บนหน้าเว็บ: ${data.stable} kg`);

            $("#weight").val(data.weight.toFixed(2));

            const weightInput = $('#weight');
            const weightLabel = $('#weightLabel');
            weightInput.val(data.weight);

            // 2. ตรวจสอบตรรกะความเสถียรเพื่อสลับสีกล่องไฟสัญญาณ
            if (data.stable === true || data.stable === "true") {
                // 🟢 สถานะนิ่งสนิท (Stable): เปลี่ยนเป็นธีมสีเขียว
                weightInput
                    .removeClass('text-danger border-danger')
                    .addClass('text-success border-success')
                    .css('background-color', '#e8f5e9'); // สีเขียวอ่อนมินต์

                weightLabel.removeClass('text-danger').addClass('text-success');
            } else {
                // 🔴 สถานะกำลังแกว่ง (Unstable): เปลี่ยนเป็นธีมสีแดงเตือนภัย
                weightInput
                    .removeClass('text-success border-success')
                    .addClass('text-danger border-danger')
                    .css('background-color', '#ffebee'); // สีแดงอ่อนพาสเทล

                weightLabel.removeClass('text-success').addClass('text-danger');
            }
        });

        function resetWeighingForm() {
            // 1. ล้างค่าใน Input/Radio/Textarea ทั้งหมด
            $('#weighingForm')[0].reset();

            // 2. ล้างค่า Hidden ID เพื่อให้ฟอร์มว่างแบบ 100%
            $('#id').val('');
            $('#createdAt').val('');
            $('#reelno').val('');
            $('#grade').val('');
            $('#size').val('');
            $('#model').val('');
            $('#diameter').val('');
            
            // ล้างช่องกรอกรอชั่งลูกใหม่
            $('#remark').val('');

            // 3. (Optional) คืนค่า CSS ขอบแดงช่อง Remark เผื่อมีค้างไว้
            $('#remark').css({ 'border-color': '', 'background-color': '', 'box-shadow': '' });
        }

    });
  // 💾 ประกาศตัวแปรเก็บอินสแตนซ์ตารางไว้ในขอบเขตนอกสุดของสคริปต์
    function fetchFilteredQueue() {
        console.log("get_next_roll")
        socket.emit('get_next_roll');
    }
</script>
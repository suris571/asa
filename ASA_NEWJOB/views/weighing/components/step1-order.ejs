<div class="mb-3 pb-3 border-bottom">
  <h7 class="text-primary font-weight-bold mb-3"><i class="fas fa-search"></i> STEP 1: ข้อมูลใบสั่งผลิต</h7>
  
  <div class="form-group mb-2">
    <label class="font-weight-bold text-sm mb-1">เลขใบสั่งผลิต</label>
    <div class="input-group flex-nowrap">
      <input type="text" class="form-control form-control-sm text-center font-weight-bold" id="orderNo" value="<%= (nextData && nextData.orderNo) ? nextData.orderNo : '' %>">
      <div class="input-group-append">
        <button class="btn btn-info btn-sm font-weight-bold text-nowrap" type="button" id="btnFetchOrder">เลือกรายการลูกม้วน</button>
      </div>
    </div>
  </div>

  <hr class="my-2">

  <div class="row text-sm">
    <div class="col-6">
      <div class="form-group mb-2">
        <label class="mb-0 text-muted font-weight-bold">วันที่ผลิต</label>
        <input readonly type="text" class="form-control form-control-sm bg-light" name="createdAt" id="createdAt" value="<%= (nextData && nextData.createdAt) ? nextData.createdAt : '' %>" readonly>
      </div>
    </div>
    <div class="col-6">
      <div class="form-group mb-2">
        <label class="mb-0 text-muted font-weight-bold">กะการทำงาน</label>
        <input readonly type="text" class="form-control form-control-sm bg-light" name="part" id="part" value="<%= (nextData && nextData.part) ? nextData.part : '' %>">
      </div>
    </div>
  </div>

  <div class="row text-sm">
    <div class="col-6">
      <div class="form-group mb-2">
        <label class="mb-0 text-muted font-weight-bold">เกรด (Grade)</label>
        <input readonly type="text" class="form-control form-control-sm bg-white" name="gradeName" id="grade" value="<%= (nextData && nextData.gradeName) ? nextData.gradeName : '' %>">
      </div>
    </div>
    <div class="col-6">
      <div class="form-group mb-2">
        <label class="mb-0 text-muted font-weight-bold">รุ่น (Version)</label>
        <input type="text" class="form-control form-control-sm bg-white" name="model" id="model" value="<%= (nextData && nextData.model) ? nextData.model : '' %>">
      </div>
    </div>
  </div>

  <div class="row text-sm">
    <div class="col-6">
      <div class="form-group mb-0">
        <label class="mb-0 text-muted font-weight-bold">ขนาด (Size)</label>
        <input readonly type="text" class="form-control form-control-sm bg-white" name="size" id="size" value="<%= (nextData && nextData.sizeName) ? nextData.sizeName : '' %>">
      </div>
    </div>
    <div class="col-6">
      <div class="form-group mb-0">
        <label class="mb-0 text-muted font-weight-bold">Diameter</label>
        <!-- <input readonly type="text" class="form-control form-control-sm bg-white" name="diameter" id="diameter" value="<%= (nextData && nextData.diameter) ? nextData.diameter : '' %>"> -->
        <input type="text" class="form-control form-control-sm bg-white" name="diameter" id="diameter" value="48">
      </div>
    </div>
  </div>
</div>
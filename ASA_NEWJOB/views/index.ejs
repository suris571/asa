<script src="/plugins/chart.js/Chart.min.js"></script>
<script>
  // ป้ายชื่อสถานะตาม cut_status_id: 1=รอตัด, 2=รอตัด(แตกเซ็ต), 3=ตัดยังไม่ครบ, 4=HOLD
  const statusLabels = ['รอสั่งตัด', 'รอตัด', 'ตัดยังไม่ครบ', 'HOLD'];
  const statusColors = ['#007bff', '#17a2b8', '#ffc107', '#dc3545'];

  let pm1Chart, pm2Chart;

  // 🎯 Plugin วาดตัวเลขจำนวนลงบนแต่ละชิ้นของกราฟโดนัท ให้เห็นได้เลยโดยไม่ต้องชี้เมาส์
  Chart.plugins.register({
    id: 'sliceValueLabels',
    afterDatasetsDraw: function (chart) {
      const ctx = chart.ctx;
      chart.data.datasets.forEach(function (dataset, i) {
        const meta = chart.getDatasetMeta(i);
        if (meta.hidden) return;
        meta.data.forEach(function (element, index) {
          const value = dataset.data[index];
          if (!value) return; // ข้ามสถานะที่มีจำนวน 0
          const model = element._model;
          const midAngle = (model.startAngle + model.endAngle) / 2;
          const radius = (model.innerRadius + model.outerRadius) / 2;
          const x = model.x + Math.cos(midAngle) * radius;
          const y = model.y + Math.sin(midAngle) * radius;
          ctx.save();
          ctx.fillStyle = '#fff';
          ctx.font = 'bold 14px sans-serif';
          ctx.textAlign = 'center';
          ctx.textBaseline = 'middle';
          ctx.fillText(value, x, y);
          ctx.restore();
        });
      });
    }
  });

  function buildChart(canvasId, statusData) {
    const values = [statusData[1] || 0, statusData[2] || 0, statusData[3] || 0, statusData[4] || 0];
    const labelsWithCount = statusLabels.map((label, i) => `${label} (${values[i]})`);

    const ctx = document.getElementById(canvasId).getContext('2d');
    return new Chart(ctx, {
      type: 'doughnut',
      data: {
        labels: labelsWithCount,
        datasets: [{
          data: values,
          backgroundColor: statusColors,
        }]
      },
      options: {
        maintainAspectRatio: false,
        responsive: true,
        legend: { position: 'bottom' }
      }
    });
  }

  // อัปเดตข้อมูลกราฟที่มีอยู่แล้วโดยไม่ต้องสร้างใหม่ (กันกราฟกระพริบ)
  function updateChart(chart, statusData) {
    const values = [statusData[1] || 0, statusData[2] || 0, statusData[3] || 0, statusData[4] || 0];
    chart.data.labels = statusLabels.map((label, i) => `${label} (${values[i]})`);
    chart.data.datasets[0].data = values;
    chart.update();
  }

  // 🎯 รอให้ /socket.io/socket.io.js (โหลดใน footer ทีหลัง) พร้อมใช้งานก่อน ค่อยเชื่อมต่อ Socket
  window.addEventListener('load', function () {
    const pm1Status = <%- JSON.stringify(data.pm1_status) %>;
    const pm2Status = <%- JSON.stringify(data.pm2_status) %>;

    pm1Chart = buildChart('pm1StatusChart', pm1Status);
    pm2Chart = buildChart('pm2StatusChart', pm2Status);

    const socket = io('/socket/updateChart');
    socket.on('chart_data_updated', function (payload) {
      updateChart(pm1Chart, payload.pm1_status);
      updateChart(pm2Chart, payload.pm2_status);
    });
  });
</script>








